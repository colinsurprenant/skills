{
  "filesystem": {
    "denyRead": [
      "~/.ssh",
      "~/.config/opencode/service*.json",
      "~/.local/state/opencode/service*.json",
      "~/.claude/ide"
    ],
    "allowWrite": [
      "~/.local/share/opencode",
      "~/.local/state/opencode",
      "~/.cache/opencode",
      "/tmp",
      "/private/tmp",
      "/private/var/folders"
    ],
    "denyWrite": [
      "~/.director",
      "~/.local/state/opencode/service*.json"
    ]
  },
  "network": {
    "allowedDomains": [
      "api.kimi.ai",
      "models.dev",
      "models.opencode.ai"
    ],
    "deniedDomains": [],
    "allowLocalBinding": true
  }
}
