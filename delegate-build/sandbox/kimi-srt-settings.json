{
  "filesystem": {
    "denyRead": [
      "~/.ssh"
    ],
    "allowWrite": [
      "~/.local/share/opencode",
      "~/.local/state/opencode",
      "~/.cache/opencode",
      "/tmp",
      "/private/tmp",
      "/private/var/folders"
    ],
    "denyWrite": [
      "~/.director"
    ]
  },
  "network": {
    "allowedDomains": [
      "api.kimi.ai",
      "models.dev",
      "models.opencode.ai"
    ],
    "deniedDomains": []
  }
}
