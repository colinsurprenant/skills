#!/usr/bin/env bash
# Renders roster.conf, the one place a model or effort is set on this machine,
# onto the files that carry it. Values are read through bin/roster-get, the one
# reader every consumer of roster.conf goes through. Three modes:
#
#   (no mode)       writes the agents/*.md frontmatter in this clone: the four
#                   Agent-tool agents delegate-builder, researcher,
#                   claude-reviewer and scout. Only the model: and effort:
#                   lines inside each agent's leading frontmatter block are
#                   rewritten; every other byte of the file is left exactly as
#                   it was, so a second run changes nothing.
#   --codex <dir>   renders the Codex agent files <dir>/delegate-builder.toml,
#                   scout.toml and researcher.toml from CODEX_BUILDER_*,
#                   CODEX_SCOUT_*, CODEX_RESEARCHER_* and the agents/<name>.md
#                   frontmatter name, description and body. bin/install --codex
#                   points it at ~/.codex/agents.
#   --claude <dir>  stages pinned copies of the four Agent-tool agents as
#                   <dir>/<name>.md (for a staged project-level .claude/agents/):
#                   the repo file with model: and effort: from roster.conf,
#                   plus a marker line directly after the opening ---.
# The role-to-file mapping below is hardcoded on purpose: it is the one place
# it lives.
#
# A generated file (--codex, --claude) is recognized by its fixed marker line:
# "Generated by bin/roster-render ... Do not edit." The marker holds no path,
# date or version, so a render from any clone is byte-identical. Nothing that
# lacks the marker is ever overwritten, and a symlink at a target path is
# never followed or replaced (Codex refuses symlinked agent files): both are
# errors, and the path is left untouched.
#
# Usage: bin/roster-render [--check]
#        bin/roster-render --codex <dir> [--check | --refresh]
#        bin/roster-render --claude <dir> [--check]
#   --check   writes nothing: exits 0 if every file already matches roster.conf
#             and agents/*.md (whole file, byte for byte in --codex and
#             --claude), else reports the drift and exits 1. A missing
#             generated file is drift.
#   --refresh (--codex only) renders only targets that already exist and carry
#             the marker, and prints nothing for any other path: bin/install
#             uses it so generated files stay current without ever creating
#             Codex state.
#   A write creates <dir> if it is missing. Files are written through a temp
#   file in the same directory and renamed into place, mode 0644.
#   Exit 1 means drift and nothing else; only --check can produce it. Every
#   configuration fault exits 78 in every mode: a roster.conf fault (malformed
#   line, duplicate key, missing or empty value, reported in bin/roster-get's
#   own words on stderr), a missing or non-executable bin/roster-get, an agent
#   file that is missing or whose frontmatter is unusable (for --codex also: a
#   description that is not a single-line plain scalar, a body that is empty
#   or contains '''), a target that is a symlink or carries no marker, and any
#   temp-file or write failure. A usage error exits 2.
#
# One line per file, parsed by bin/install and bin/doctor:
#   rendered agents/x.md (model=opus, effort=xhigh)
#   unchanged agents/x.md
#   ok agents/x.md: model=opus, effort=xhigh             (--check)
#   drift agents/x.md: effort 'high' vs roster 'xhigh'   (--check)
#   error agents/x.md: frontmatter has 2 model: keys, expected exactly 1
# In --codex and --claude the path is the target file, printed as ~/... under
# $HOME, and an error line is printed in both modes (stdout in --check, stderr
# otherwise):
#   drift ~/.codex/agents/x.toml: model 'a' vs roster 'b'
#   drift ~/.codex/agents/x.toml: developer_instructions differs from agents/x.md
#   drift ~/.codex/agents/x.toml: missing
#   error ~/.codex/agents/x.toml: was not generated by bin/roster-render ...
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo="$(cd "$here/.." && pwd -P)"

usage() {
  {
    echo "usage: bin/roster-render [--check]"
    echo "       bin/roster-render --codex <dir> [--check | --refresh]"
    echo "       bin/roster-render --claude <dir> [--check]"
  } >&2
  exit 2
}

check=0; refresh=0; target=""; target_dir=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --check)   [ "$check" = 0 ] || usage; check=1; shift ;;
    --refresh) [ "$refresh" = 0 ] || usage; refresh=1; shift ;;
    --codex|--claude)
      [ -z "$target" ] || usage
      [ "$#" -ge 2 ] || usage
      # The directory is an operand, not an option: one that reads as a flag
      # is almost certainly a missing argument, so refuse it.
      case "$2" in ''|-*) usage ;; esac
      target="${1#--}"; target_dir="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[ "$check" = 0 ] || [ "$refresh" = 0 ] || usage
[ "$refresh" = 0 ] || [ "$target" = codex ] || usage
# Trailing slashes would print as a// in every path.
while [ "${target_dir%/}" != "$target_dir" ] && [ -n "${target_dir%/}" ]; do
  target_dir="${target_dir%/}"
done

die() { echo "bin/roster-render: $*" >&2; exit 78; }

# The temp file lives next to its target, so it exists only for the moment
# between mktemp and the rename; the trap makes sure an interrupt in that
# window leaves no .roster-render.* behind.
cur_tmp=""
cleanup() { [ -z "$cur_tmp" ] || rm -f -- "$cur_tmp"; cur_tmp=""; }
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# bin/roster-get is the one reader of roster.conf: it validates the whole file,
# rejects duplicate keys and empty values, and owns the error text, so this
# script never parses the roster itself — it only maps roles to files. A failed
# read prints its own message and its exit status (78) becomes this script's,
# via set -e on the assignment below.
[ -x "$here/roster-get" ] || die "$here/roster-get: missing or not executable"
need() { "$here/roster-get" "$1"; }

report() { # report <rel> <why> — an error, in whichever mode we are running
  if [ "$check" = 1 ]; then printf 'error %s: %s\n' "$1" "$2"
  else echo "bin/roster-render: $1: $2" >&2; fi
}

# The ~ goes through a variable and is concatenated, never substituted with a
# backslash escape: bash 5 tilde-expands a literal ~ in a ${x/#$HOME/~}
# replacement back to $HOME, and bash 3.2 keeps a backslash-escaped one.
tilde='~'
disp() { # disp <path> — the path, as ~/... when it sits under $HOME
  local p="$1"
  if [ -n "${HOME:-}" ] && [ "$HOME" != / ]; then
    case "$p" in "$HOME"/*) p="$tilde${p#"$HOME"}" ;; esac
  fi
  printf '%s' "$p"
}

# The same error line in both modes for the generated-file modes: the verb is
# the contract, where is only stdout or stderr.
report_t() { # report_t <display path> <why>
  if [ "$check" = 1 ]; then printf 'error %s: %s\n' "$1" "$2"
  else printf 'error %s: %s\n' "$1" "$2" >&2; fi
}

# Source-file checks shared by every mode. They set $fault and return 78; the
# caller words the report. A second model:/effort: line would leave one copy
# stale after a render, and an unterminated block would make the whole file
# read as frontmatter — refuse both, in every mode.
fault=""; fm=""; close=""
validate_frontmatter() { # validate_frontmatter <file> — sets fm and close
  local f="$1"
  fault=""
  [ -f "$f" ] || { fault="file missing"; return 78; }
  [ -r "$f" ] || { fault="not readable"; return 78; }
  [ "$(sed -n 1p "$f")" = "---" ] || { fault="no leading --- frontmatter block"; return 78; }
  close="$(awk 'NR>1 && /^---$/ {print NR; exit}' "$f")"
  [ -n "$close" ] || { fault="frontmatter block is never closed by a --- line"; return 78; }
  fm="$(awk '/^---$/{n++; next} n==1' "$f")"
}
validate_pins() { # validate_pins — model: and effort: each appear exactly once in $fm
  local n_model n_effort
  n_model="$(printf '%s\n' "$fm" | grep -c '^model:' || true)"
  n_effort="$(printf '%s\n' "$fm" | grep -c '^effort:' || true)"
  [ "$n_model" -eq 1 ]  || { fault="frontmatter has $n_model model: keys, expected exactly 1";  return 78; }
  [ "$n_effort" -eq 1 ] || { fault="frontmatter has $n_effort effort: keys, expected exactly 1"; return 78; }
}

# The Agent-tool agents with their pins rewritten, on stdout. n==1 is "inside
# the leading frontmatter": a later --- in the body only bumps the counter past
# 1, so prose is never touched. A non-empty marker becomes a YAML comment line
# directly after the opening ---.
render_md() { # render_md <file> <model> <effort> [marker]
  awk -v model="$2" -v effort="$3" -v marker="${4:-}" '
    /^---$/            { n++; print; if (n == 1 && marker != "") print marker; next }
    n == 1 && /^model:/  { print "model: " model;   next }
    n == 1 && /^effort:/ { print "effort: " effort; next }
                       { print }
  ' "$1"
}

# Called in an `||` context, so `set -e` is OFF inside it: every step that can
# fail is checked explicitly, and the file is replaced only after the render
# has fully succeeded. Reporting 'rendered' for a write that did not happen is
# the one failure mode this script must never have.
# Returns 0 for a clean file, 1 for drift (--check only), 78 for a fault — the
# caller keeps the two apart so the script's own exit status can too.
render_one() { # render_one <agent> <model> <effort>
  local agent="$1" model="$2" effort="$3"
  local rel="agents/$agent.md" f="$repo/agents/$agent.md"
  local cur_model cur_effort bad tmp mode

  validate_frontmatter "$f" || { report "$rel" "$fault"; return 78; }
  validate_pins || { report "$rel" "$fault"; return 78; }
  cur_model="$(printf '%s\n' "$fm" | sed -n 's/^model:[[:space:]]*//p' | sed -n 1p)"
  cur_effort="$(printf '%s\n' "$fm" | sed -n 's/^effort:[[:space:]]*//p' | sed -n 1p)"

  if [ "$check" = 1 ]; then
    bad=""
    [ "$cur_model" = "$model" ] || bad="model '$cur_model' vs roster '$model'"
    [ "$cur_effort" = "$effort" ] || bad="${bad:+$bad; }effort '$cur_effort' vs roster '$effort'"
    if [ -n "$bad" ]; then printf 'drift %s: %s\n' "$rel" "$bad"; return 1; fi
    printf 'ok %s: model=%s, effort=%s\n' "$rel" "$model" "$effort"
    return 0
  fi

  # Same directory as the target, so the replacement below is a rename within
  # one filesystem: a reader sees either the whole old file or the whole new
  # one, never a half-written agent.
  tmp="$(mktemp "$(dirname "$f")/.roster-render.XXXXXX")" \
    || { report "$rel" "could not create a temp file in $(dirname "$rel")/"; return 78; }
  cur_tmp="$tmp"
  if ! render_md "$f" "$model" "$effort" > "$tmp"; then
    cleanup; report "$rel" "render failed while writing the temp file"; return 78
  fi
  # A zero-byte render means something went wrong upstream of the write; the
  # source always has at least a frontmatter block, so it can never be right.
  if [ ! -s "$tmp" ]; then
    cleanup; report "$rel" "rendered output was empty; refusing to write"; return 78
  fi
  # mktemp creates the temp file 0600 and the rename carries that mode across,
  # so put the target's own mode on it first — the mode copy is what keeps the
  # agent files 644. (The ~/.claude/agents/*.md symlinks resolve by path, not
  # by inode, so the new inode a rename installs leaves them valid.)
  if [ "$(uname -s)" = Darwin ]; then mode="$(stat -f %Lp "$f" 2>/dev/null)"
  else mode="$(stat -c %a "$f" 2>/dev/null)"; fi
  if [ -z "$mode" ] || ! chmod "$mode" "$tmp"; then
    cleanup; report "$rel" "could not copy the file's mode onto the temp file"; return 78
  fi
  if cmp -s "$f" "$tmp"; then
    cleanup
    printf 'unchanged %s\n' "$rel"
    return 0
  fi
  if ! mv -f "$tmp" "$f"; then
    cleanup; report "$rel" "could not replace the file; it is unchanged"; return 78
  fi
  cur_tmp=""
  printf 'rendered %s (model=%s, effort=%s)\n' "$rel" "$model" "$effort"
}

# ---- --codex and --claude: generated copies in another directory ----------

codex_marker='# Generated by bin/roster-render --codex from roster.conf and agents/*.md. Do not edit.'
claude_marker='# Generated by bin/roster-render --claude from roster.conf and agents/*.md. Do not edit.'

# A control character other than tab (TOML rejects them in both string forms,
# and a CR would not survive the parse) makes the file unrenderable.
has_ctrl() { # has_ctrl <text>
  printf '%s\n' "$1" | LC_ALL=C grep -q $'[\001-\010\013-\037\177]'
}

toml_str() { # toml_str <text> — the text escaped for a TOML basic string
  printf '%s\n' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# <key>: exactly once in $fm; its value, trailing whitespace trimmed, in $fm_val.
fm_val=""
fm_scalar() { # fm_scalar <key>
  local n
  n="$(printf '%s\n' "$fm" | grep -c "^$1:" || true)"
  [ "$n" -eq 1 ] || { fault="frontmatter has $n $1: keys, expected exactly 1"; return 78; }
  fm_val="$(printf '%s\n' "$fm" | sed -n "s/^$1:[[:space:]]*//p")"
  fm_val="${fm_val%"${fm_val##*[![:space:]]}"}"
}

# True if the line after the description: line (blank lines skipped) is
# indented, which makes the YAML value a multi-line plain scalar.
description_continues() {
  printf '%s\n' "$fm" | awk '
    seen && /^[ \t]*$/ { next }
    seen               { r = ($0 ~ /^[ \t]/); seen = 0; done = 1; next }
    /^description:/ && !done { seen = 1 }
    END                { exit !r }'
}

# The agent's body: everything after the closing ---, leading and trailing
# blank lines trimmed, no final newline. A literal TOML string cannot hold
# ''' and Codex drops a file whose developer_instructions is empty, so both
# are errors.
body=""
agent_body() { # agent_body <file>
  body="$(tail -n +$((close + 1)) < "$1" | awk '
    { l[NR] = $0 }
    END {
      s = 1; while (s <= NR && l[s] ~ /^[ \t]*$/) s++
      e = NR; while (e >= s && l[e] ~ /^[ \t]*$/) e--
      for (i = s; i <= e; i++) print l[i]
    }')"
  [ -n "$body" ] || { fault="body is empty after trimming (Codex drops a file with no developer_instructions)"; return 78; }
  case "$body" in
    *"'''"*) fault="body contains ''' and cannot be a TOML literal string"; return 78 ;;
  esac
  if has_ctrl "$body"; then fault="body contains a control character other than tab or newline"; return 78; fi
}

# Sets $want to the exact bytes of the target file, or returns 78 with $fault.
want=""
build_codex() { # build_codex <agent> <model> <effort>
  local agent="$1" model="$2" effort="$3" src="$repo/agents/$1.md" name desc c
  validate_frontmatter "$src" || return 78
  fm_scalar name || return 78
  name="$fm_val"
  case "$name" in
    '') fault="frontmatter name: is empty"; return 78 ;;
    *[!A-Za-z0-9_-]*) fault="frontmatter name '$name' is not a plain token"; return 78 ;;
  esac
  [ "$name" = "$agent" ] || { fault="frontmatter name '$name' does not match the role '$agent'"; return 78; }
  fm_scalar description || return 78
  desc="$fm_val"
  [ -n "$desc" ] || { fault="description is empty or not on the description: line; it must be a single-line plain scalar"; return 78; }
  c="${desc:0:1}"
  case "$c" in
    '"'|"'") fault="description is quoted; it must be a single-line plain scalar"; return 78 ;;
    '|'|'>') fault="description is a block scalar; it must be a single-line plain scalar"; return 78 ;;
    '['|'{'|'&'|'*'|'!'|'%'|'@'|'`'|'#') fault="description starts with '$c', so it is not a plain scalar"; return 78 ;;
  esac
  if description_continues; then fault="description spans several lines; it must be a single-line plain scalar"; return 78; fi
  case "$desc" in
    *" #"*) fault="description contains ' #', which YAML reads as a comment"; return 78 ;;
  esac
  if has_ctrl "$desc"; then fault="description contains a control character other than tab"; return 78; fi
  agent_body "$src" || return 78
  if has_ctrl "$model" || has_ctrl "$effort"; then fault="roster value contains a control character"; return 78; fi
  want="$(
    printf '%s\n' "$codex_marker"
    printf 'name = "%s"\n' "$(toml_str "$name")"
    printf 'description = "%s"\n' "$(toml_str "$desc")"
    printf 'model = "%s"\n' "$(toml_str "$model")"
    printf 'model_reasoning_effort = "%s"\n' "$(toml_str "$effort")"
    printf "developer_instructions = '''\n"
    printf "%s'''\n" "$body"
    printf x)"
  want="${want%x}"
}

build_claude() { # build_claude <agent> <model> <effort>
  local src="$repo/agents/$1.md" rc
  validate_frontmatter "$src" || return 78
  validate_pins || return 78
  want="$(render_md "$src" "$2" "$3" "$claude_marker"; printf 'x%s' "$?")"
  rc="${want##*x}"; want="${want%x*}"
  [ "$rc" = 0 ] || { fault="render failed"; return 78; }
  [ -n "$want" ] || { fault="rendered output was empty; refusing to write"; return 78; }
}

# True if <file> starts with the kind's marker: line 1 for a .toml, line 2
# (under the opening ---) for an agent .md.
is_ours() { # is_ours <kind> <file>
  local l1="" l2=""
  { IFS= read -r l1 || true; IFS= read -r l2 || true; } < "$2"
  case "$1" in
    codex)  [ "$l1" = "$codex_marker" ] ;;
    claude) [ "$l1" = "---" ] && [ "$l2" = "$claude_marker" ] ;;
  esac
}

# The 1-based line at which <file> first differs from $want.
first_diff_line() { # first_diff_line <file>
  W="${want%$'\n'}" awk '
    BEGIN { n = split(ENVIRON["W"], w, "\n") }
    NR > n || ($0 "") != (w[NR] "") { print NR; found = 1; exit }
    END { if (!found) print (NR < n ? NR + 1 : NR) }' "$1"
}

# Names what first differs: the TOML key, the YAML frontmatter key, or the body.
drift_note() { # drift_note <kind> <agent> <file> <model> <effort>
  local kind="$1" agent="$2" t="$3" n have wline key
  n="$(first_diff_line "$t")"
  have="$(sed -n "${n}p" < "$t")"
  if [ "$kind" = codex ]; then
    case "$n" in
      1) echo "marker line differs" ;;
      2) echo "name differs from agents/$agent.md" ;;
      3) echo "description differs from agents/$agent.md" ;;
      4) have="${have#*= }"; have="${have#\"}"; have="${have%\"}"
         echo "model '$have' vs roster '$4'" ;;
      5) have="${have#*= }"; have="${have#\"}"; have="${have%\"}"
         echo "model_reasoning_effort '$have' vs roster '$5'" ;;
      6) echo "developer_instructions header differs" ;;
      *) echo "developer_instructions differs from agents/$agent.md (first at line $n)" ;;
    esac
    return
  fi
  wline="$(printf '%s' "$want" | sed -n "${n}p")"
  case "$wline" in
    model:*)  have="${have#*:}"; have="${have# }"; echo "model '$have' vs roster '$4'"; return ;;
    effort:*) have="${have#*:}"; have="${have# }"; echo "effort '$have' vs roster '$5'"; return ;;
  esac
  if [ "$n" -le 2 ]; then echo "opening --- or marker line differs"; return; fi
  if [ "$n" -le $((close + 1)) ]; then key="${wline%%:*}"; echo "frontmatter '$key' differs from agents/$agent.md"; return; fi
  echo "body differs from agents/$agent.md (first at line $n)"
}

# One generated file. Same calling convention as render_one: 0 clean, 1 drift,
# 78 fault, called in an `||` context so every failure is checked explicitly.
stage_one() { # stage_one <codex|claude> <agent> <model> <effort>
  local kind="$1" agent="$2" model="$3" effort="$4"
  local ext t tdisp state why tmp
  case "$kind" in codex) ext=toml ;; *) ext=md ;; esac
  t="$target_dir/$agent.$ext"; tdisp="$(disp "$t")"

  # What is at the target path decides everything else. A symlink is never
  # followed (Codex refuses a symlinked agent file, and replacing it would
  # mean acting on something other than the file the user sees), and a file
  # that does not carry the marker is not ours to overwrite.
  state=missing; why=""
  if [ -L "$t" ]; then
    state=refuse; why="is a symlink; not followed and not replaced"
    if [ "$kind" = codex ]; then why="$why (Codex refuses a symlinked agent file)"; fi
  elif [ -e "$t" ]; then
    if [ ! -f "$t" ]; then state=refuse; why="exists and is not a regular file; left untouched"
    elif [ ! -r "$t" ]; then state=refuse; why="is not readable; left untouched"
    elif ! is_ours "$kind" "$t"; then state=refuse; why="was not generated by bin/roster-render (no marker line); left untouched"
    else state=ours; fi
  fi
  # --refresh touches only what an earlier run generated: a missing path is
  # not created, and a path that is not ours is not this mode's business.
  if [ "$refresh" = 1 ] && [ "$state" != ours ]; then return 0; fi
  if [ "$state" = refuse ]; then report_t "$tdisp" "$why"; return 78; fi
  if [ -e "$target_dir" ] && [ ! -d "$target_dir" ]; then
    report_t "$tdisp" "$(disp "$target_dir") exists and is not a directory"; return 78
  fi

  if [ "$kind" = codex ]; then build_codex "$agent" "$model" "$effort" || { report_t "$tdisp" "agents/$agent.md: $fault"; return 78; }
  else build_claude "$agent" "$model" "$effort" || { report_t "$tdisp" "agents/$agent.md: $fault"; return 78; }
  fi

  if [ "$check" = 1 ]; then
    if [ "$state" = missing ]; then printf 'drift %s: missing\n' "$tdisp"; return 1; fi
    if cmp -s -- "$t" <(printf '%s' "$want"); then
      printf 'ok %s: model=%s, effort=%s\n' "$tdisp" "$model" "$effort"
      return 0
    fi
    printf 'drift %s: %s\n' "$tdisp" "$(drift_note "$kind" "$agent" "$t" "$model" "$effort")"
    return 1
  fi

  if [ "$state" = ours ] && cmp -s -- "$t" <(printf '%s' "$want"); then
    printf 'unchanged %s\n' "$tdisp"
    return 0
  fi
  if [ ! -d "$target_dir" ]; then
    mkdir -p -- "$target_dir" 2>/dev/null && [ -d "$target_dir" ] \
      || { report_t "$tdisp" "could not create the directory $(disp "$target_dir")"; return 78; }
  fi
  tmp="$(mktemp -- "$target_dir/.roster-render.XXXXXX")" \
    || { report_t "$tdisp" "could not create a temp file in $(disp "$target_dir")/"; return 78; }
  cur_tmp="$tmp"
  if ! printf '%s' "$want" > "$tmp"; then
    cleanup; report_t "$tdisp" "render failed while writing the temp file"; return 78
  fi
  # mktemp makes the temp file 0600 and the rename carries that across.
  if ! chmod -- 0644 "$tmp"; then
    cleanup; report_t "$tdisp" "could not set the mode on the temp file"; return 78
  fi
  if ! mv -f -- "$tmp" "$t"; then
    cleanup; report_t "$tdisp" "could not replace the file; it is unchanged"; return 78
  fi
  cur_tmp=""
  printf 'rendered %s (model=%s, effort=%s)\n' "$tdisp" "$model" "$effort"
}

# Every file is visited whatever the first one said — one broken agent file
# should not hide the state of the others — but a fault outranks drift in
# the verdict: 78 says "this configuration cannot be rendered", 1 says only
# "the files no longer match the roster".
drift=0; fault_seen=0
score() { # score <render's status>
  case "$1" in
    0)  ;;
    78) fault_seen=1 ;;
    *)  drift=$((drift+1)) ;;
  esac
}

case "$target" in
  codex)
    builder_model="$(need CODEX_BUILDER_MODEL)"
    builder_effort="$(need CODEX_BUILDER_EFFORT)"
    scout_model="$(need CODEX_SCOUT_MODEL)"
    scout_effort="$(need CODEX_SCOUT_EFFORT)"
    researcher_model="$(need CODEX_RESEARCHER_MODEL)"
    researcher_effort="$(need CODEX_RESEARCHER_EFFORT)"
    stage_one codex delegate-builder "$builder_model"    "$builder_effort"    || score $?
    stage_one codex scout            "$scout_model"      "$scout_effort"      || score $?
    stage_one codex researcher       "$researcher_model" "$researcher_effort" || score $?
    ;;
  *)
    builder_model="$(need BUILDER_MODEL)"
    builder_effort="$(need BUILDER_EFFORT)"
    researcher_model="$(need RESEARCHER_MODEL)"
    researcher_effort="$(need RESEARCHER_EFFORT)"
    reviewer_model="$(need CLAUDE_REVIEWER_MODEL)"
    reviewer_effort="$(need CLAUDE_REVIEWER_EFFORT)"
    scout_model="$(need SCOUT_MODEL)"
    scout_effort="$(need SCOUT_EFFORT)"
    if [ "$target" = claude ]; then
      stage_one claude delegate-builder "$builder_model"    "$builder_effort"    || score $?
      stage_one claude researcher       "$researcher_model" "$researcher_effort" || score $?
      stage_one claude claude-reviewer  "$reviewer_model"   "$reviewer_effort"   || score $?
      stage_one claude scout            "$scout_model"      "$scout_effort"      || score $?
    else
      render_one delegate-builder "$builder_model"    "$builder_effort"    || score $?
      render_one researcher       "$researcher_model" "$researcher_effort" || score $?
      render_one claude-reviewer  "$reviewer_model"   "$reviewer_effort"   || score $?
      render_one scout            "$scout_model"      "$scout_effort"      || score $?
    fi
    ;;
esac

[ "$fault_seen" -eq 0 ] || exit 78
[ "$drift" -eq 0 ]
