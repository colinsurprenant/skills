#!/usr/bin/env bash
# Reports which parts of this clone can actually run on this machine.
# Only the Core checks and the core symlinks are required; the repo is a menu,
# not a bundle, and every optional tool that is missing simply retires the
# lane that needs it. The exit status scores required checks only.
#
# Usage: bin/doctor [--deep]
#   --deep also probes provider model lists (needs network, can be slow).
set -uo pipefail

deep=0
[ "${1:-}" = "--deep" ] && deep=1

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

ok=0; req_missing=0; opt_missing=0
required=0
OK="  ok  "; NO="  --  "

row() { printf '  %-38s %s %s\n' "$1" "$2" "${3:-}"; }

have() { command -v "$1" >/dev/null 2>&1; }

miss() {
  if [ "$required" = 1 ]; then req_missing=$((req_missing+1)); else opt_missing=$((opt_missing+1)); fi
}

# A link counts only if it resolves to exactly its documented target; a link
# to some other file, even inside this clone, silently serves different
# content and is exactly the drift this check exists to catch.
links_to() { # links_to <link> <absolute expected target>
  [ -L "$1" ] || return 1
  t="$(readlink "$1")"
  case "$t" in /*) ;; *) t="$(dirname "$1")/$t" ;; esac
  [ "$(cd "$(dirname "$t")" 2>/dev/null && pwd -P)/$(basename "$t")" = "$2" ]
}

check_cmd() {
  if have "$2"; then row "$1" "$OK" "$(command -v "$2")"; ok=$((ok+1)); return 0
  else row "$1" "$NO" "${3:-not installed}"; miss; return 1; fi
}

check_link() { # check_link <path> <repo-relative expected target> [missing-note]
  if links_to "$1" "$repo/$2"; then row "${1/#$HOME/~}" "$OK"; ok=$((ok+1)); return 0
  elif [ -e "$1" ] || [ -L "$1" ]; then row "${1/#$HOME/~}" "$NO" "exists but is not a link to $2"; miss; return 1
  else row "${1/#$HOME/~}" "$NO" "${3:-not linked}"; miss; return 1; fi
}

echo
echo "skills doctor — $repo"

echo
echo "Platform"
case "$(uname -s)" in
  Darwin) row "macOS $(sw_vers -productVersion 2>/dev/null || echo '?')" "$OK" "sandbox lanes supported" ;;
  *)      row "$(uname -s)" "$NO" "sandbox lanes need macOS Seatbelt; everything else works" ;;
esac

echo
echo "Core"
required=1
check_cmd "claude CLI" claude "install Claude Code first"
check_link "$HOME/.claude/CLAUDE.md" CLAUDE.global.md "behavior file will not load"

echo
echo "Wiring — symlinks into this clone"
check_link "$HOME/.claude/skills/audit-directives" audit-directives
check_link "$HOME/.claude/skills/opus-build" opus-build
check_link "$HOME/.claude/agents/opus-builder.md" agents/opus-builder.md
check_link "$HOME/.claude/agents/opus-reviewer.md" agents/opus-reviewer.md
check_link "$HOME/.claude/agents/researcher.md" agents/researcher.md
check_link "$HOME/.claude/commands/iterate.md" commands/iterate.md
required=0
check_link "$HOME/.codex/AGENTS.md" AGENT_BEHAVIOR.md "optional: Codex CLI behavior file"
check_link "$HOME/.config/opencode/AGENTS.md" AGENT_BEHAVIOR.md "optional: OpenCode behavior file"

echo
echo "ROSTER bindings — agents/*.md frontmatter vs ROSTER.md"
# ROSTER.md is the single place a role-to-model binding lives; this section
# keeps its mechanically checkable surfaces honest. Rows whose access path is
# an Agent-tool subagent must have agents/<name>.md present with model:/effort:
# frontmatter agreeing with the table. No model is named in this script: the
# table is the source of truth, the frontmatter is the surface under test.
# Rows with no installable surface (main loop, built-in agents) stay prose.
required=1
bindings=0
while IFS='|' read -r _ b_role b_requires b_model b_access _; do
  b_role="$(printf '%s' "$b_role" | sed 's/^ *//;s/ *$//')"
  b_requires="$(printf '%s' "$b_requires" | sed 's/^ *//;s/ *$//')"
  b_model="$(printf '%s' "$b_model" | sed 's/^ *//;s/ *$//')"
  b_access="$(printf '%s' "$b_access" | sed 's/^ *//;s/ *$//')"
  agent="$(printf '%s' "$b_access" | sed -n 's/^Agent tool `\([^`]*\)`.*/\1/p')"
  [ -n "$agent" ] || continue
  bindings=$((bindings+1))
  f="$repo/agents/$agent.md"
  if [ ! -f "$f" ]; then
    row "$b_role → agents/$agent.md" "$NO" "file missing"; miss; continue
  fi
  fm="$(awk '/^---$/{n++; next} n==1' "$f")"
  fm_model="$(printf '%s\n' "$fm" | sed -n 's/^model:[[:space:]]*//p')"
  fm_effort="$(printf '%s\n' "$fm" | sed -n 's/^effort:[[:space:]]*//p')"
  fam="$(printf '%s' "$b_model" | awk '{print tolower($1)}')"
  want_effort="$(printf '%s' "$b_requires" | sed -n 's/.*,[[:space:]]*//p')"
  bad=""
  case "$fm_model" in
    *"$fam"*) ;;
    *) bad="model '$fm_model' vs roster '$b_model'" ;;
  esac
  if [ -n "$want_effort" ] && [ "$fm_effort" != "$want_effort" ]; then
    bad="${bad:+$bad; }effort '${fm_effort:-unset}' vs roster '$want_effort'"
  fi
  if [ -z "$bad" ]; then
    row "$b_role → agents/$agent.md" "$OK" "$fm_model${fm_effort:+, $fm_effort}"; ok=$((ok+1))
  else
    row "$b_role → agents/$agent.md" "$NO" "$bad"; miss
  fi
done < <(grep '^|' "$repo/ROSTER.md")
if [ "$bindings" -eq 0 ]; then
  row "ROSTER bindings table" "$NO" "no 'Agent tool' rows parsed from ROSTER.md"; miss
fi
required=0

echo
echo "Trim"
check_cmd "node (status line)" node "status line will not render"
if grep -q "statusline.js" "$HOME/.claude/settings.json" 2>/dev/null; then
  row "statusLine configured" "$OK"
else
  row "statusLine configured" "$NO" "add it to ~/.claude/settings.json (see SETUP.md)"
fi

echo
echo "Sandboxing"
check_cmd "srt (sandbox-runtime)" srt "npm i -g @anthropic-ai/sandbox-runtime"
# A preference, not a capability: report the state, don't score it.
if grep -q '"enabled": *true' "$HOME/.claude/settings.json" 2>/dev/null; then
  row "Claude Code Bash sandbox" " on   " "sandboxed commands skip permission prompts"
else
  row "Claude Code Bash sandbox" " off  " "opt-in; see SETUP.md"
fi

echo
echo "opus-build Phase 4 review lanes"
lanes=0
if grep -q "codex@openai-codex" "$HOME/.claude/plugins/installed_plugins.json" 2>/dev/null; then
  row "Codex" "$OK" "codex plugin installed"; lanes=$((lanes+1))
else
  row "Codex" "$NO" "install the openai/codex-plugin-cc plugin"
fi
if have opencode && have srt; then
  if [ "$deep" = 1 ]; then
    if opencode models 2>/dev/null | grep -q "^${K3_MODEL:-kimi-for-coding/k3}$"; then
      row "Kimi K3" "$OK" "${K3_MODEL:-kimi-for-coding/k3} available"; lanes=$((lanes+1))
    else
      row "Kimi K3" "$NO" "${K3_MODEL:-kimi-for-coding/k3} not in 'opencode models'"
    fi
  else
    row "Kimi K3" "$OK" "opencode + srt present (model unverified; --deep to check)"; lanes=$((lanes+1))
  fi
else
  need=""; have opencode || need="opencode"; have srt || need="${need:+$need and }srt"
  row "Kimi K3" "$NO" "needs $need"
fi
# Opus bills Anthropic tokens: opt-in per SKILL.md, never part of the
# no-cost roster the lane count announces.
if have claude && have srt; then
  row "Opus (sandboxed, opt-in)" "$OK" "claude + srt present"; opus_lane="live"
else
  need=""; have claude || need="claude"; have srt || need="${need:+$need and }srt"
  row "Opus (sandboxed, opt-in)" "$NO" "needs $need; in-session opus-reviewer agent still works"; opus_lane="retired"
fi

echo
if [ "$req_missing" -eq 0 ]; then
  echo "$lanes of 2 no-cost review lanes live, Opus opt-in lane $opus_lane; $ok checks ok, $opt_missing optional unmet."
  echo "Unmet optional checks are fine — they retire a lane, they do not break the rest."
else
  echo "$lanes of 2 no-cost review lanes live, Opus opt-in lane $opus_lane; $ok checks ok, $req_missing REQUIRED unmet, $opt_missing optional unmet."
  echo "Fix the required checks (SETUP.md, Required: Claude Code); optional ones only retire lanes."
fi
echo "Role-to-model bindings: ROSTER.md (Agent-tool rows and review lanes verified above; main-loop and built-in rows stay prose)."
echo
[ "$req_missing" -eq 0 ]
