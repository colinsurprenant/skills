#!/usr/bin/env bash
# Reports which parts of this clone can actually run on this machine.
# Only the Core checks and the core symlinks are required; the repo is a menu,
# not a bundle, and every optional tool that is missing simply retires the
# lane that needs it. The exit status scores required checks only.
#
# No model or effort is named in this script. roster.conf holds every value;
# this script reads it and checks the surfaces (agents/*.md frontmatter, the
# Codex agent files, the review lanes) against it. ROSTER.md is prose about
# roles, not a data source.
#
# Usage: bin/doctor [--deep]
#   --deep also runs live probes: one real prompt through the Kimi lane
#   (delegate-build/sandbox/kimi-review.sh, 120 s limit) and the GPT_REVIEWER_*
#   and CODEX_* pins checked against `codex debug models`. Needs network, spends
#   a little plan usage on the Kimi prompt, and can take up to a couple of minutes.
set -uo pipefail

deep=0
[ "${1:-}" = "--deep" ] && deep=1

repo="$(CDPATH='' cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

# --deep scratch space: probe output, and the Kimi wrapper's tee'd report (it
# lands in $TMPDIR, which the probe points here so nothing outlives the run).
# The trap also stops a probe still running when doctor is interrupted.
deep_tmp=""; probe_pid=""
deep_cleanup() {
  [ -z "$probe_pid" ] || kill -TERM -- "-$probe_pid" 2>/dev/null
  [ -z "$deep_tmp" ] || rm -rf -- "$deep_tmp"
}
if [ "$deep" = 1 ]; then
  deep_tmp="$(mktemp -d "${TMPDIR:-/tmp}/doctor-deep-XXXXXX")" || exit 1
  trap deep_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
fi

ok=0; req_missing=0; opt_missing=0
required=0
OK="  ok  "; NO="  --  "

row() { printf '  %-38s %s %s\n' "$1" "$2" "${3:-}"; }

have() { command -v "$1" >/dev/null 2>&1; }

miss() {
  if [ "$required" = 1 ]; then req_missing=$((req_missing+1)); else opt_missing=$((opt_missing+1)); fi
}

. "$repo/bin/lib/links.sh" || exit 1

check_cmd() {
  if have "$2"; then row "$1" "$OK" "$(command -v "$2")"; ok=$((ok+1)); return 0
  else row "$1" "$NO" "${3:-not installed}"; miss; return 1; fi
}

# The ~ goes through a variable: bash 5 tilde-expands a literal ~ in the
# replacement back to $HOME, and bash 3.2 keeps a backslash-escaped one.
tilde='~'
check_link() { # check_link <path> <repo-relative expected target> [missing-note]
  if links_to "$1" "$repo/$2"; then row "${1/#$HOME/$tilde}" "$OK"; ok=$((ok+1)); return 0
  elif [ -e "$1" ] || [ -L "$1" ]; then row "${1/#$HOME/$tilde}" "$NO" "exists but is not a link to $2"; miss; return 1
  else row "${1/#$HOME/$tilde}" "$NO" "${3:-not linked}"; miss; return 1; fi
}

# bin/roster-get is the one reader of roster.conf — the same one bin/roster-render
# and the review wrappers go through, so doctor validates the file exactly the
# way its consumers do instead of keeping a second, kinder parser here. Call it
# plainly, never inside a command substitution: both globals have to survive.
roster_val=""     # the value from the last successful read
roster_err=""     # bin/roster-get's message from the last failed read
roster_broken=0   # 1 once a file-level fault has been reported, to keep it to one row
roster_read() { # roster_read <key> — 0 and roster_val, or 1 and roster_err
  local out rc
  out="$("$repo/bin/roster-get" "$1" 2>&1)"; rc=$?
  roster_val=""; roster_err=""
  if [ "$rc" -ne 0 ]; then roster_err="$out"; return 1; fi
  roster_val="$out"
}

pin_row() { # pin_row <label> <key>… — what roster.conf pins this lane to
  local label="$1" k vals="" from="roster.conf" bad=""
  shift
  for k in "$@"; do
    if roster_read "$k"; then
      if [ -n "$roster_val" ]; then vals="${vals:+$vals, }$roster_val"; else from="$from; $k empty"; fi
    else
      bad="${bad:+$bad; }$roster_err"
    fi
  done
  if [ -n "$bad" ]; then
    row "$label" "$NO" "$bad"; miss
  else
    row "$label" "$OK" "$vals ($from)"; ok=$((ok+1))
  fi
}

# run_limited <seconds> <stdout-file> <stderr-file> <cmd>…: --deep only. Returns
# the command's status, or 124 on timeout. timeout(1) is not in macOS's base
# system (coreutils brings timeout or gtimeout); without either, poll and kill.
# The command runs in its own process group (set -m) so a timeout, or the
# trap's TERM on interrupt, takes the whole tree down (srt, opencode), not just
# the wrapper.
run_limited() {
  local secs="$1" out="$2" err="$3" t="" ticks=0 rc
  shift 3
  t="$(command -v timeout || command -v gtimeout)" || t=""
  set -m
  if [ -n "$t" ]; then "$t" -k 5 "$secs" "$@" >"$out" 2>"$err" </dev/null &
  else "$@" >"$out" 2>"$err" </dev/null &
  fi
  probe_pid=$!
  set +m
  if [ -z "$t" ]; then
    while kill -0 "$probe_pid" 2>/dev/null; do
      if [ "$ticks" -ge $((secs * 5)) ]; then
        kill -TERM -- "-$probe_pid" 2>/dev/null; sleep 1; kill -KILL -- "-$probe_pid" 2>/dev/null
        { wait "$probe_pid"; } 2>/dev/null; probe_pid=""
        return 124
      fi
      sleep 0.2; ticks=$((ticks+1))
    done
  fi
  { wait "$probe_pid"; } 2>/dev/null; rc=$?
  probe_pid=""
  return "$rc"
}

# probe_error_line <file>…: the first line worth showing from a failed probe:
# ANSI stripped, blanks dropped, the wrapper's own banner and opencode's benign
# "Error starting FSEvents stream" (SKILL.md) skipped, then the first line that
# reads like an error, else the last line left, else "no output". An error that
# opens a JSON object ("Error: {") takes its next few lines too, joined.
probe_error_line() {
  local esc line
  esc="$(printf '\033')"
  line="$(cat -- "$@" 2>/dev/null | sed "s/${esc}\[[0-9;?]*[A-Za-z]//g" | tr -d '\r' \
    | grep -Ev '^[[:space:]]*$|^kimi-review: tee|^> |FSEvents' \
    | awk '
        !found && tolower($0) ~ /error|fail|fatal|panic|exception|denied|refused|abort|crash|unauthori|not found|invalid/ {
          found = 1; msg = $0; if ($0 ~ /[{[][[:space:]]*$/) more = 5; next }
        found && more > 0 { s = $0; sub(/^[[:space:]]+/, "", s); msg = msg " " s; more--; next }
        { last = $0 }
        END { print found ? msg : last }')"
  [ -n "$line" ] || line="no output"
  printf '%.160s' "$line"
}

# codex_catalog_checks: --deep only. Checks GPT_REVIEWER_* and every
# CODEX_*_{MODEL,EFFORT} pin against Codex's own catalog (`codex debug models`),
# so a typo'd slug or an effort the model does not offer fails here and not when
# Codex spawns the agent. This repo keeps no effort list: the catalog says what
# each model accepts. With a login and network the catalog is the account's live
# list; otherwise Codex falls back to the copy bundled in the binary, silently
# and with exit 0, so a catalog byte-identical to `--bundled` is labeled that way.
# The role names mirror bin/roster-render --codex, the other place that names
# the CODEX_* keys; bin/roster-get has no list-keys mode.
codex_catalog_checks() {
  local json="$deep_tmp/codex-models.json" err="$deep_tmp/codex-models.err"
  local tsv="$deep_tmp/codex-models.tsv" secs=30 tab src rc label mk ek model effort line efforts offered
  tab="$(printf '\t')"
  run_limited "$secs" "$json" "$err" codex debug models; rc=$?
  if [ "$rc" = 124 ]; then
    row "Codex catalog" "$NO" "codex debug models timed out after $secs s"; miss; return
  elif [ "$rc" -ne 0 ]; then
    row "Codex catalog" "$NO" "codex debug models exited $rc: $(probe_error_line "$err")"; miss; return
  fi
  # One line per model: slug, supported efforts (comma-joined), visibility.
  if have jq; then
    jq -r '.models[] | [.slug, ([.supported_reasoning_levels[]?.effort] | join(",")), (.visibility // "")] | @tsv' \
      "$json" >"$tsv" 2>/dev/null
  elif have python3; then
    python3 -c 'import json, sys
for m in json.load(sys.stdin)["models"]:
    print("\t".join([m["slug"], ",".join(l["effort"] for l in m.get("supported_reasoning_levels") or []), m.get("visibility") or ""]))' \
      <"$json" >"$tsv" 2>/dev/null
  else
    row "Codex catalog" "$NO" "needs jq or python3 to read codex debug models"; miss; return
  fi
  if [ ! -s "$tsv" ]; then
    row "Codex catalog" "$NO" "codex debug models listed no models"; miss; return
  fi
  src="live"
  codex debug models --bundled 2>/dev/null | cmp -s - "$json" && src="bundled, no live list"

  set -- "Codex catalog: GPT lane"   GPT_REVIEWER_MODEL      GPT_REVIEWER_EFFORT \
         "Codex catalog: builder"    CODEX_BUILDER_MODEL     CODEX_BUILDER_EFFORT \
         "Codex catalog: scout"      CODEX_SCOUT_MODEL       CODEX_SCOUT_EFFORT \
         "Codex catalog: researcher" CODEX_RESEARCHER_MODEL  CODEX_RESEARCHER_EFFORT
  while [ "$#" -gt 0 ]; do
    label="$1"; mk="$2"; ek="$3"; shift 3
    if ! roster_read "$mk"; then row "$label" "$NO" "$roster_err"; miss; continue; fi
    model="$roster_val"
    if ! roster_read "$ek"; then row "$label" "$NO" "$roster_err"; miss; continue; fi
    effort="$roster_val"
    # ENVIRON, not awk -v: -v would interpret backslash escapes in the slug.
    line="$(M="$model" awk -F "$tab" '$1 == ENVIRON["M"] { print; exit }' "$tsv")"
    if [ -z "$line" ]; then
      offered="$(awk -F "$tab" '$3 == "list" { printf "%s%s", sep, $1; sep = ", " }' "$tsv")"
      row "$label" "$NO" "$model not in Codex catalog ($src); offered: $offered"; miss; continue
    fi
    efforts="$(printf '%s\n' "$line" | cut -f2)"
    if [ -z "$efforts" ]; then
      row "$label" "$OK" "$model, $effort in Codex catalog ($src); effort unverified, catalog lists none"; ok=$((ok+1))
    else
      case ",$efforts," in
        *",$effort,"*) row "$label" "$OK" "$model, $effort in Codex catalog ($src)"; ok=$((ok+1)) ;;
        *) row "$label" "$NO" "$model has no effort $effort in Codex catalog ($src); offers ${efforts//,/, }"; miss ;;
      esac
    fi
  done
}

echo
echo "skills doctor — $repo"

echo
echo "Platform"
case "$(uname -s)" in
  Darwin) row "macOS $(sw_vers -productVersion 2>/dev/null || echo '?')" "$OK" "sandbox lanes supported" ;;
  *)      row "$(uname -s)" "$NO" "sandbox lanes need macOS Seatbelt; everything else works" ;;
esac

echo
echo "Core"
required=1
check_cmd "claude CLI" claude "install Claude Code first"
check_link "$HOME/.claude/CLAUDE.md" CLAUDE.global.md "behavior file will not load"

echo
echo "Wiring — symlinks into this clone"
check_link "$HOME/.claude/skills/audit-directives" audit-directives
check_link "$HOME/.claude/skills/delegate-build" delegate-build
check_link "$HOME/.claude/agents/delegate-builder.md" agents/delegate-builder.md
check_link "$HOME/.claude/agents/claude-reviewer.md" agents/claude-reviewer.md
check_link "$HOME/.claude/agents/researcher.md" agents/researcher.md
check_link "$HOME/.claude/agents/scout.md" agents/scout.md
check_link "$HOME/.claude/commands/iterate.md" commands/iterate.md
# Links from before the delegate-build rename. One that still names its old
# target in this clone is stale: that target is gone, and the link keeps the old
# name listed. Anything else at those paths is not ours, and bin/install leaves
# it alone too. A clean state is one summary row, a stale link is one row each.
stale=0
for pair in "${pre_rename_links[@]}"; do
  old_link="$HOME/.claude/${pair%%:*}"
  if is_pre_rename_link "$old_link" "${pair#*:}"; then
    row "${old_link/#$HOME/$tilde}" "$NO" "stale pre-rename link; run bin/install"; miss; stale=1
  fi
done
[ "$stale" = 1 ] || { row "pre-rename links" "$OK" "none"; ok=$((ok+1)); }
required=0
check_link "$HOME/.codex/AGENTS.md" AGENT_BEHAVIOR.md "optional: Codex CLI behavior file"
# delegate-build for Codex is the skill link plus the generated agent files. On
# a machine with codex but neither (nothing at the link path, and no file
# bin/roster-render generated in ~/.codex/agents), it was never installed, and
# one row says so instead of a missing link and three missing files.
# roster-render --codex --refresh --check prints nothing unless a generated file
# is there, so any output at all means one is.
codex_skill="$HOME/.agents/skills/delegate-build"
codex_unused=0
if have codex && [ ! -e "$codex_skill" ] && [ ! -L "$codex_skill" ] \
   && [ -z "$("$repo/bin/roster-render" --codex "$HOME/.codex/agents" --refresh --check 2>&1)" ]; then
  codex_unused=1
fi
if [ "$codex_unused" = 1 ]; then
  row "delegate-build not installed for Codex" "$NO" "optional: bin/install --codex"; miss
else
  check_link "$codex_skill" delegate-build "optional: delegate-build skill for Codex (bin/install --codex)"
fi
check_link "$HOME/.config/opencode/AGENTS.md" AGENT_BEHAVIOR.md "optional: OpenCode behavior file"
check_link "$HOME/.copilot/copilot-instructions.md" AGENT_BEHAVIOR.md "optional: Copilot CLI behavior file"

echo
echo "roster.conf — every model and effort on this machine"
# roster.conf is the single place a value is set; this section keeps the
# surfaces it feeds honest. The agent rows come from bin/roster-render --check,
# which owns the role-to-file mapping; the Codex agent file rows come from
# bin/roster-render --codex --check, which compares each whole file; the lane
# rows echo the pins the delegate-build wrappers read, so a swap that missed a
# wrapper shows up here.
required=1
if [ ! -f "$repo/roster.conf" ]; then
  row "roster.conf" "$NO" "missing; nothing binds a role to a model"; miss
  roster_broken=1
elif ! roster_read BUILDER_MODEL; then
  # One reader, one verdict: bin/roster-get validates the whole file on every
  # call, so a file-level fault (malformed line, duplicate key) fails every key
  # and every consumer. Report it once, here, and skip the rows below that would
  # each repeat the same message.
  row "roster.conf" "$NO" "$roster_err"; miss
  roster_broken=1
else
  row "roster.conf" "$OK" "$(grep -Ec '^[A-Z][A-Z0-9_]*=[^[:space:]]*$' "$repo/roster.conf") keys, valid"; ok=$((ok+1))
  agent_rows=0; render_lines=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    render_lines=$((render_lines+1))
    r_st="${line%% *}"; r_rest="${line#* }"
    case "$r_st" in
      ok|drift|error) ;;
      *) row "bin/roster-render --check" "$NO" "$line"; miss; continue ;;
    esac
    agent_rows=$((agent_rows+1))
    r_path="${r_rest%%:*}"; r_note="${r_rest#*: }"
    if [ "$r_st" = ok ]; then row "$r_path" "$OK" "$r_note"; ok=$((ok+1))
    else row "$r_path" "$NO" "$r_note"; miss; fi
  done < <("$repo/bin/roster-render" --check 2>&1)
  # Silent render: no rows and no complaint of its own is itself a failure.
  if [ "$agent_rows" -eq 0 ] && [ "$render_lines" -eq 0 ]; then
    row "bin/roster-render --check" "$NO" "reported no agent files"; miss
  fi

  # Codex agent files: optional, the way Codex itself is. They are copies
  # (Codex refuses a symlinked agent file), so a roster.conf or agents/*.md
  # edit that never reached ~/.codex/agents shows up here as drift, whole file
  # compared, and bin/install --codex is the fix. Without codex on PATH there
  # is nothing to verify: one row says so instead. With codex but nothing
  # installed for it, the one "not installed" row under Wiring already said so.
  required=0
  if [ "$codex_unused" = 1 ]; then
    :
  elif have codex; then
    codex_rows=0
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      r_st="${line%% *}"; r_rest="${line#* }"
      case "$r_st" in
        ok|drift|error) ;;
        *) row "bin/roster-render --codex --check" "$NO" "$line"; miss; continue ;;
      esac
      codex_rows=$((codex_rows+1))
      r_path="${r_rest%%:*}"; r_note="${r_rest#*: }"
      case "$r_st" in
        ok)    row "$r_path" "$OK" "$r_note"; ok=$((ok+1)) ;;
        drift) row "$r_path" "$NO" "$r_note; run bin/install --codex"; miss ;;
        *)     row "$r_path" "$NO" "$r_note"; miss ;;
      esac
    done < <("$repo/bin/roster-render" --codex "$HOME/.codex/agents" --check 2>&1)
    if [ "$codex_rows" -eq 0 ]; then
      row "bin/roster-render --codex --check" "$NO" "reported no Codex agent files"; miss
    fi
  else
    row "Codex agent files" "$NO" "optional: codex not installed"; miss
  fi

  # Lane pins: informational, and optional the way the lanes themselves are.
  pin_row "GPT lane" GPT_REVIEWER_MODEL GPT_REVIEWER_EFFORT
  pin_row "Kimi lane" KIMI_REVIEWER_MODEL KIMI_REVIEWER_VARIANT
  pin_row "Claude lane" CLAUDE_REVIEWER_MODEL CLAUDE_REVIEWER_EFFORT
  # Without codex on PATH the "Codex agent files" row above already says so.
  if [ "$deep" = 1 ] && have codex; then codex_catalog_checks; fi
fi
required=0

echo
echo "Trim"
check_cmd "node (status line)" node "status line will not render"
if grep -q "statusline.js" "$HOME/.claude/settings.json" 2>/dev/null; then
  row "statusLine configured" "$OK"
else
  row "statusLine configured" "$NO" "add it to ~/.claude/settings.json (see SETUP.md)"
fi

echo
echo "Sandboxing"
check_cmd "srt (sandbox-runtime)" srt "npm i -g @anthropic-ai/sandbox-runtime"
# A preference, not a capability: report the state, don't score it.
if grep -q '"enabled": *true' "$HOME/.claude/settings.json" 2>/dev/null; then
  row "Claude Code Bash sandbox" " on   " "sandboxed commands skip permission prompts"
else
  row "Claude Code Bash sandbox" " off  " "opt-in; see SETUP.md"
fi

echo
echo "delegate-build Phase 4 review lanes"
lanes=0
# Every pin below comes from the same one reader. A file-level fault was already
# reported once in the roster section, so these rows defer to it instead of
# repeating it three times — and never claim a key is unset when the file is.
pin_fault="pin unknown: see the roster.conf row above"
gpt_pin="$pin_fault"; kimi_model=""; kimi_pin="$pin_fault"; claude_pin="$pin_fault"
# A lane is live only if every pin behind it was read: tooling that is present
# but aimed at an unknown model is not a working lane, so an unread pin makes
# the row NO and keeps the lane out of the count, whatever the tooling says.
gpt_pinned=0; kimi_pinned=0; claude_pinned=0
if [ "$roster_broken" = 0 ]; then
  gpt_pinned=1; kimi_pinned=1; claude_pinned=1
  if roster_read GPT_REVIEWER_MODEL; then gpt_pin="$roster_val"; else gpt_pin="$roster_err"; gpt_pinned=0; fi
  if roster_read GPT_REVIEWER_EFFORT; then gpt_pin="$gpt_pin${roster_val:+, $roster_val}"
  else gpt_pin="$gpt_pin; $roster_err"; gpt_pinned=0; fi
  if roster_read KIMI_REVIEWER_MODEL; then
    kimi_model="$roster_val"; kimi_pin="$kimi_model"
    if roster_read KIMI_REVIEWER_VARIANT; then kimi_pin="$kimi_pin${roster_val:+, variant $roster_val}"
    else kimi_pin="$kimi_pin; $roster_err"; kimi_pinned=0; fi
  else
    kimi_pin="$roster_err"; kimi_pinned=0
  fi
  if roster_read CLAUDE_REVIEWER_MODEL; then claude_pin="$roster_val"; else claude_pin="$roster_err"; claude_pinned=0; fi
  if roster_read CLAUDE_REVIEWER_EFFORT; then claude_pin="$claude_pin${roster_val:+, $roster_val}"
  else claude_pin="$claude_pin; $roster_err"; claude_pinned=0; fi
fi
# The plugin dispatches to the local codex CLI (it spawns `codex app-server`), so
# the plugin entry alone does not make the lane live. Login is not checked. An
# installed plugin counts as disabled only when enabledPlugins says false.
if [ "$gpt_pinned" = 0 ]; then
  row "GPT (via Codex)" "$NO" "$gpt_pin"
else
  gpt_plugin=0
  if grep -q "codex@openai-codex" "$HOME/.claude/plugins/installed_plugins.json" 2>/dev/null; then
    gpt_plugin=1
    grep -q '"codex@openai-codex": *false' "$HOME/.claude/settings.json" 2>/dev/null && gpt_plugin=2
  fi
  if [ "$gpt_plugin" = 1 ] && have codex; then
    row "GPT (via Codex)" "$OK" "codex plugin installed, codex on PATH; $gpt_pin"; lanes=$((lanes+1))
  else
    need=""
    [ "$gpt_plugin" = 0 ] && need="the openai/codex-plugin-cc plugin"
    [ "$gpt_plugin" = 2 ] && need="the codex plugin enabled (enabledPlugins in ~/.claude/settings.json)"
    have codex || need="${need:+$need and }the codex CLI on PATH"
    row "GPT (via Codex)" "$NO" "needs $need; $gpt_pin"
  fi
fi
if [ "$kimi_pinned" = 0 ] || [ -z "$kimi_model" ]; then
  row "Kimi (via OpenCode)" "$NO" "$kimi_pin"
elif have opencode && have srt; then
  if [ "$deep" = 1 ]; then
    # A model id in `opencode models` proved nothing: a build whose prompt path
    # crashes lists it just the same. So send one real prompt through the
    # wrapper the lane really uses, and call the lane live only on a real answer.
    # PONG is matched in stdout alone: the prompt itself says PONG and an error
    # path may echo it.
    kimi_secs=120
    run_limited "$kimi_secs" "$deep_tmp/kimi.out" "$deep_tmp/kimi.err" \
      env TMPDIR="$deep_tmp" "$repo/delegate-build/sandbox/kimi-review.sh" \
      "Reply with exactly PONG and nothing else."
    kimi_rc=$?
    if [ "$kimi_rc" = 124 ]; then
      row "Kimi (via OpenCode)" "$NO" "prompt timed out after $kimi_secs s; $kimi_pin"
    elif [ "$kimi_rc" -eq 0 ] && grep -q PONG "$deep_tmp/kimi.out"; then
      row "Kimi (via OpenCode)" "$OK" "$kimi_pin answered a real prompt"; lanes=$((lanes+1))
    else
      row "Kimi (via OpenCode)" "$NO" "no PONG reply (wrapper exit $kimi_rc): $(probe_error_line "$deep_tmp/kimi.err" "$deep_tmp/kimi.out"); $kimi_pin"
    fi
  else
    row "Kimi (via OpenCode)" "$OK" "opencode + srt present; $kimi_pin unverified (--deep to check)"; lanes=$((lanes+1))
  fi
else
  need=""; have opencode || need="opencode"; have srt || need="${need:+$need and }srt"
  row "Kimi (via OpenCode)" "$NO" "needs $need"
fi
# The Claude lane bills Anthropic tokens: opt-in under the skill's lane policy
# (SKILL.md, and the mechanics file for the harness in use), never part of the
# no-cost roster the lane count announces. The in-session claude-reviewer agent
# named in the fallback row is a Claude Code feature; a Codex main loop has no
# such fallback and simply goes without this lane when srt is missing.
if [ "$claude_pinned" = 0 ]; then
  row "Claude (sandboxed, opt-in)" "$NO" "$claude_pin"; claude_lane="retired"
elif have claude && have srt; then
  row "Claude (sandboxed, opt-in)" "$OK" "claude + srt present; $claude_pin"; claude_lane="live"
else
  need=""; have claude || need="claude"; have srt || need="${need:+$need and }srt"
  row "Claude (sandboxed, opt-in)" "$NO" "needs $need; in Claude Code the in-session claude-reviewer agent still works"; claude_lane="retired"
fi

echo
if [ "$req_missing" -eq 0 ]; then
  echo "$lanes of 2 no-cost review lanes live, Claude opt-in lane $claude_lane; $ok checks ok, $opt_missing optional unmet."
  echo "Unmet optional checks are fine — they retire a lane, they do not break the rest."
else
  echo "$lanes of 2 no-cost review lanes live, Claude opt-in lane $claude_lane; $ok checks ok, $req_missing REQUIRED unmet, $opt_missing optional unmet."
  echo "Fix the required checks (SETUP.md, Required: Claude Code); optional ones only retire lanes."
fi
echo "Models and efforts: roster.conf (agent frontmatter, Codex agent files and lane pins verified above)."
echo "Edit roster.conf, run bin/roster-render (Claude agents) and bin/install (Codex agent files), rerun this. ROSTER.md explains the roles."
echo
[ "$req_missing" -eq 0 ]
