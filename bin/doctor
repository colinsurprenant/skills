#!/usr/bin/env bash
# Reports which parts of this clone can actually run on this machine.
# Only the Core checks and the core symlinks are required; the repo is a menu,
# not a bundle, and every optional tool that is missing simply retires the
# lane that needs it. The exit status scores required checks only.
#
# No model or effort is named in this script. roster.conf holds every value;
# this script reads it and checks the surfaces (agents/*.md frontmatter, the
# review lanes) against it. ROSTER.md is prose about roles, not a data source.
#
# Usage: bin/doctor [--deep]
#   --deep also probes provider model lists (needs network, can be slow).
set -uo pipefail

deep=0
[ "${1:-}" = "--deep" ] && deep=1

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

ok=0; req_missing=0; opt_missing=0
required=0
OK="  ok  "; NO="  --  "

row() { printf '  %-38s %s %s\n' "$1" "$2" "${3:-}"; }

have() { command -v "$1" >/dev/null 2>&1; }

miss() {
  if [ "$required" = 1 ]; then req_missing=$((req_missing+1)); else opt_missing=$((opt_missing+1)); fi
}

# A link counts only if it resolves to exactly its documented target; a link
# to some other file, even inside this clone, silently serves different
# content and is exactly the drift this check exists to catch.
links_to() { # links_to <link> <absolute expected target>
  [ -L "$1" ] || return 1
  t="$(readlink "$1")"
  case "$t" in /*) ;; *) t="$(dirname "$1")/$t" ;; esac
  [ "$(cd "$(dirname "$t")" 2>/dev/null && pwd -P)/$(basename "$t")" = "$2" ]
}

check_cmd() {
  if have "$2"; then row "$1" "$OK" "$(command -v "$2")"; ok=$((ok+1)); return 0
  else row "$1" "$NO" "${3:-not installed}"; miss; return 1; fi
}

check_link() { # check_link <path> <repo-relative expected target> [missing-note]
  if links_to "$1" "$repo/$2"; then row "${1/#$HOME/~}" "$OK"; ok=$((ok+1)); return 0
  elif [ -e "$1" ] || [ -L "$1" ]; then row "${1/#$HOME/~}" "$NO" "exists but is not a link to $2"; miss; return 1
  else row "${1/#$HOME/~}" "$NO" "${3:-not linked}"; miss; return 1; fi
}

# bin/roster-get is the one reader of roster.conf — the same one bin/roster-render
# and the review wrappers go through, so doctor validates the file exactly the
# way its consumers do instead of keeping a second, kinder parser here. Call it
# plainly, never inside a command substitution: both globals have to survive.
roster_val=""     # the value from the last successful read
roster_err=""     # bin/roster-get's message from the last failed read
roster_broken=0   # 1 once a file-level fault has been reported, to keep it to one row
roster_read() { # roster_read <key> — 0 and roster_val, or 1 and roster_err
  local out rc
  out="$("$repo/bin/roster-get" "$1" 2>&1)"; rc=$?
  roster_val=""; roster_err=""
  if [ "$rc" -ne 0 ]; then roster_err="$out"; return 1; fi
  roster_val="$out"
}

pin_row() { # pin_row <label> <key>… — what roster.conf pins this lane to
  local label="$1" k vals="" from="roster.conf" bad=""
  shift
  for k in "$@"; do
    if roster_read "$k"; then
      if [ -n "$roster_val" ]; then vals="${vals:+$vals, }$roster_val"; else from="$from; $k empty"; fi
    else
      bad="${bad:+$bad; }$roster_err"
    fi
  done
  if [ -n "$bad" ]; then
    row "$label" "$NO" "$bad"; miss
  else
    row "$label" "$OK" "$vals ($from)"; ok=$((ok+1))
  fi
}

echo
echo "skills doctor — $repo"

echo
echo "Platform"
case "$(uname -s)" in
  Darwin) row "macOS $(sw_vers -productVersion 2>/dev/null || echo '?')" "$OK" "sandbox lanes supported" ;;
  *)      row "$(uname -s)" "$NO" "sandbox lanes need macOS Seatbelt; everything else works" ;;
esac

echo
echo "Core"
required=1
check_cmd "claude CLI" claude "install Claude Code first"
check_link "$HOME/.claude/CLAUDE.md" CLAUDE.global.md "behavior file will not load"

echo
echo "Wiring — symlinks into this clone"
check_link "$HOME/.claude/skills/audit-directives" audit-directives
check_link "$HOME/.claude/skills/opus-build" opus-build
check_link "$HOME/.claude/agents/opus-builder.md" agents/opus-builder.md
check_link "$HOME/.claude/agents/opus-reviewer.md" agents/opus-reviewer.md
check_link "$HOME/.claude/agents/researcher.md" agents/researcher.md
check_link "$HOME/.claude/commands/iterate.md" commands/iterate.md
required=0
check_link "$HOME/.codex/AGENTS.md" AGENT_BEHAVIOR.md "optional: Codex CLI behavior file"
check_link "$HOME/.config/opencode/AGENTS.md" AGENT_BEHAVIOR.md "optional: OpenCode behavior file"
check_link "$HOME/.copilot/copilot-instructions.md" AGENT_BEHAVIOR.md "optional: Copilot CLI behavior file"

echo
echo "roster.conf — every model and effort on this machine"
# roster.conf is the single place a value is set; this section keeps the
# surfaces it feeds honest. The agent rows come from bin/roster-render --check,
# which owns the role-to-file mapping; the lane rows echo the pins the
# opus-build wrappers read, so a swap that missed a wrapper shows up here.
required=1
if [ ! -f "$repo/roster.conf" ]; then
  row "roster.conf" "$NO" "missing; nothing binds a role to a model"; miss
  roster_broken=1
elif ! roster_read BUILDER_MODEL; then
  # One reader, one verdict: bin/roster-get validates the whole file on every
  # call, so a file-level fault (malformed line, duplicate key) fails every key
  # and every consumer. Report it once, here, and skip the rows below that would
  # each repeat the same message.
  row "roster.conf" "$NO" "$roster_err"; miss
  roster_broken=1
else
  row "roster.conf" "$OK" "$(grep -Ec '^[A-Z][A-Z0-9_]*=[^[:space:]]*$' "$repo/roster.conf") keys, valid"; ok=$((ok+1))
  agent_rows=0; render_lines=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    render_lines=$((render_lines+1))
    r_st="${line%% *}"; r_rest="${line#* }"
    case "$r_st" in
      ok|drift|error) ;;
      *) row "bin/roster-render --check" "$NO" "$line"; miss; continue ;;
    esac
    agent_rows=$((agent_rows+1))
    r_path="${r_rest%%:*}"; r_note="${r_rest#*: }"
    if [ "$r_st" = ok ]; then row "$r_path" "$OK" "$r_note"; ok=$((ok+1))
    else row "$r_path" "$NO" "$r_note"; miss; fi
  done < <("$repo/bin/roster-render" --check 2>&1)
  # Silent render: no rows and no complaint of its own is itself a failure.
  if [ "$agent_rows" -eq 0 ] && [ "$render_lines" -eq 0 ]; then
    row "bin/roster-render --check" "$NO" "reported no agent files"; miss
  fi

  # Lane pins: informational, and optional the way the lanes themselves are.
  required=0
  pin_row "Scout" SCOUT_MODEL
  pin_row "Codex lane" CODEX_MODEL CODEX_EFFORT
  pin_row "Kimi K3 lane" K3_MODEL K3_VARIANT
  pin_row "Opus review lane" OPUS_REVIEWER_MODEL OPUS_REVIEWER_EFFORT
fi
required=0

echo
echo "Trim"
check_cmd "node (status line)" node "status line will not render"
if grep -q "statusline.js" "$HOME/.claude/settings.json" 2>/dev/null; then
  row "statusLine configured" "$OK"
else
  row "statusLine configured" "$NO" "add it to ~/.claude/settings.json (see SETUP.md)"
fi

echo
echo "Sandboxing"
check_cmd "srt (sandbox-runtime)" srt "npm i -g @anthropic-ai/sandbox-runtime"
# A preference, not a capability: report the state, don't score it.
if grep -q '"enabled": *true' "$HOME/.claude/settings.json" 2>/dev/null; then
  row "Claude Code Bash sandbox" " on   " "sandboxed commands skip permission prompts"
else
  row "Claude Code Bash sandbox" " off  " "opt-in; see SETUP.md"
fi

echo
echo "opus-build Phase 4 review lanes"
lanes=0
# Every pin below comes from the same one reader. A file-level fault was already
# reported once in the roster section, so these rows defer to it instead of
# repeating it three times — and never claim a key is unset when the file is.
pin_fault="pin unknown: see the roster.conf row above"
codex_pin="$pin_fault"; k3_model=""; k3_pin="$pin_fault"; opus_pin="$pin_fault"
# A lane is live only if every pin behind it was read: tooling that is present
# but aimed at an unknown model is not a working lane, so an unread pin makes
# the row NO and keeps the lane out of the count, whatever the tooling says.
codex_pinned=0; k3_pinned=0; opus_pinned=0
if [ "$roster_broken" = 0 ]; then
  codex_pinned=1; k3_pinned=1; opus_pinned=1
  if roster_read CODEX_MODEL; then codex_pin="$roster_val"; else codex_pin="$roster_err"; codex_pinned=0; fi
  if roster_read CODEX_EFFORT; then codex_pin="$codex_pin${roster_val:+, $roster_val}"
  else codex_pin="$codex_pin; $roster_err"; codex_pinned=0; fi
  if roster_read K3_MODEL; then
    k3_model="$roster_val"; k3_pin="$k3_model"
    if roster_read K3_VARIANT; then k3_pin="$k3_pin${roster_val:+, variant $roster_val}"
    else k3_pin="$k3_pin; $roster_err"; k3_pinned=0; fi
  else
    k3_pin="$roster_err"; k3_pinned=0
  fi
  if roster_read OPUS_REVIEWER_MODEL; then opus_pin="$roster_val"; else opus_pin="$roster_err"; opus_pinned=0; fi
  if roster_read OPUS_REVIEWER_EFFORT; then opus_pin="$opus_pin${roster_val:+, $roster_val}"
  else opus_pin="$opus_pin; $roster_err"; opus_pinned=0; fi
fi
if [ "$codex_pinned" = 0 ]; then
  row "Codex" "$NO" "$codex_pin"
elif grep -q "codex@openai-codex" "$HOME/.claude/plugins/installed_plugins.json" 2>/dev/null; then
  row "Codex" "$OK" "codex plugin installed; $codex_pin"; lanes=$((lanes+1))
else
  row "Codex" "$NO" "install the openai/codex-plugin-cc plugin; $codex_pin"
fi
if [ "$k3_pinned" = 0 ] || [ -z "$k3_model" ]; then
  row "Kimi K3" "$NO" "$k3_pin"
elif have opencode && have srt; then
  if [ "$deep" = 1 ]; then
    # -x -F --: the pin is a literal to match whole-line, not a regex; a slug
    # with a '.' or a '+' in it would otherwise match the wrong catalog entry.
    if opencode models 2>/dev/null | grep -qxF -- "$k3_model"; then
      row "Kimi K3" "$OK" "$k3_pin available"; lanes=$((lanes+1))
    else
      row "Kimi K3" "$NO" "$k3_model not in 'opencode models'"
    fi
  else
    row "Kimi K3" "$OK" "opencode + srt present; $k3_pin unverified (--deep to check)"; lanes=$((lanes+1))
  fi
else
  need=""; have opencode || need="opencode"; have srt || need="${need:+$need and }srt"
  row "Kimi K3" "$NO" "needs $need"
fi
# Opus bills Anthropic tokens: opt-in per SKILL.md, never part of the
# no-cost roster the lane count announces.
if [ "$opus_pinned" = 0 ]; then
  row "Opus (sandboxed, opt-in)" "$NO" "$opus_pin"; opus_lane="retired"
elif have claude && have srt; then
  row "Opus (sandboxed, opt-in)" "$OK" "claude + srt present; $opus_pin"; opus_lane="live"
else
  need=""; have claude || need="claude"; have srt || need="${need:+$need and }srt"
  row "Opus (sandboxed, opt-in)" "$NO" "needs $need; in-session opus-reviewer agent still works"; opus_lane="retired"
fi

echo
if [ "$req_missing" -eq 0 ]; then
  echo "$lanes of 2 no-cost review lanes live, Opus opt-in lane $opus_lane; $ok checks ok, $opt_missing optional unmet."
  echo "Unmet optional checks are fine — they retire a lane, they do not break the rest."
else
  echo "$lanes of 2 no-cost review lanes live, Opus opt-in lane $opus_lane; $ok checks ok, $req_missing REQUIRED unmet, $opt_missing optional unmet."
  echo "Fix the required checks (SETUP.md, Required: Claude Code); optional ones only retire lanes."
fi
echo "Models and efforts: roster.conf (agent frontmatter and lane pins verified above)."
echo "Edit roster.conf, run bin/roster-render, rerun this. ROSTER.md explains the roles."
echo
[ "$req_missing" -eq 0 ]
