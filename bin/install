#!/usr/bin/env bash
# Creates the symlinks SETUP.md documents: the required Claude Code set by
# default, the optional harness links by flag. Renders agents/*.md frontmatter
# from roster.conf first, so the links land on current files.
# Before linking, removes links left by the delegate-build rename (opus-build,
# opus-builder, opus-reviewer) that still point into this clone.
# Idempotent and non-clobbering:
# a link already resolving into this clone is left alone, and anything else
# occupying a target path is reported, never replaced. Finishes by running
# bin/doctor, which is the referee for whether the install actually took —
# if this script and doctor ever disagree about a link, doctor wins.
#
# Usage: bin/install [--codex] [--opencode] [--copilot] [--all]
set -uo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

do_codex=0; do_opencode=0; do_copilot=0
for arg in "$@"; do
  case "$arg" in
    --codex)    do_codex=1 ;;
    --opencode) do_opencode=1 ;;
    --copilot)  do_copilot=1 ;;
    --all)      do_codex=1; do_opencode=1; do_copilot=1 ;;
    *) echo "usage: bin/install [--codex] [--opencode] [--copilot] [--all]" >&2; exit 2 ;;
  esac
done

made=0; kept=0; removed=0; refused=0; render_failed=0
OK="  ok  "; NO="  --  "
row() { printf '  %-44s %s %s\n' "${1/#$HOME/~}" "$2" "${3:-}"; }

# Stricter than doctor's into-this-clone test: a link counts only if it
# resolves to exactly the documented source. A link to some other file,
# even one inside this clone, is left alone and reported like any other
# occupant.
links_to() { # links_to <link> <absolute expected source>
  [ -L "$1" ] || return 1
  t="$(readlink "$1")"
  case "$t" in /*) ;; *) t="$(dirname "$1")/$t" ;; esac
  [ "$(cd "$(dirname "$t")" 2>/dev/null && pwd -P)/$(basename "$t")" = "$2" ]
}

# True if <link> is a symlink whose readlink text points into this clone. The
# target is read as text, never resolved: a stale pre-rename link is dangling by
# construction, so resolving it would find nothing. Only the target's directory
# is canonicalized (when it exists), so a relative link or a `..` spelling still
# lands under "$repo". Same test as bin/doctor's stale-link row.
points_into_clone() { # points_into_clone <link>
  local t d
  [ -L "$1" ] || return 1
  t="$(readlink "$1")"
  case "$t" in /*) ;; *) t="$(dirname "$1")/$t" ;; esac
  d="$(CDPATH='' cd -- "$(dirname "$t")" 2>/dev/null && pwd -P)" || d="$(dirname "$t")"
  case "$d/$(basename "$t")" in "$repo"/*) return 0 ;; *) return 1 ;; esac
}

# The delegate-build rename left three links under ~/.claude that point at paths
# this clone no longer has. Remove each one that points into this clone; rm on
# a symlink acts on the link itself, so a dangling one goes too. Anything else at
# those paths belongs to someone else: reported and left alone, exactly like a
# link() refusal.
migrate_pre_rename() {
  local old dst found=0
  for old in skills/opus-build agents/opus-builder.md agents/opus-reviewer.md; do
    dst="$HOME/.claude/$old"
    if points_into_clone "$dst"; then
      found=1
      if rm -f -- "$dst"; then
        row "$dst" "$OK" "removed pre-rename link"; removed=$((removed+1))
      else
        row "$dst" "$NO" "pre-rename link could not be removed; left alone"; refused=$((refused+1))
      fi
    elif [ -e "$dst" ] || [ -L "$dst" ]; then
      found=1
      row "$dst" "$NO" "exists and is not a pre-rename link into this clone; left alone"; refused=$((refused+1))
    fi
  done
  [ "$found" = 1 ] || row "pre-rename links" "$OK" "none present"
}

link() { # link <repo-relative source> <absolute target>
  src="$repo/$1"; dst="$2"
  if links_to "$dst" "$src"; then
    row "$dst" "$OK" "already linked"; kept=$((kept+1))
  elif [ -e "$dst" ] || [ -L "$dst" ]; then
    row "$dst" "$NO" "exists and is not a link to its documented target; left alone"; refused=$((refused+1))
  else
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
    row "$dst" "$OK" "created"; made=$((made+1))
  fi
}

# agents/*.md frontmatter is generated from roster.conf, so render it before
# the links go in: a link should point at a file that already matches the
# roster. bin/roster-render prints one line per agent file; each becomes a row.
render_agents() {
  if ! r_out="$("$repo/bin/roster-render" 2>&1)"; then
    render_failed=1
    while IFS= read -r r_line; do
      [ -n "$r_line" ] || continue
      row "bin/roster-render" "$NO" "$r_line"
    done <<< "$r_out"
    return
  fi
  while IFS= read -r r_line; do
    [ -n "$r_line" ] || continue
    r_verb="${r_line%% *}"; r_rest="${r_line#* }"
    r_path="${r_rest%% *}"; r_note="${r_rest#"$r_path"}"; r_note="${r_note# }"
    row "$r_path" "$OK" "$r_verb${r_note:+ $r_note}"
  done <<< "$r_out"
}

echo
echo "skills install — $repo"

echo
echo "Claude Code (required set)"
migrate_pre_rename
link CLAUDE.global.md            "$HOME/.claude/CLAUDE.md"
link audit-directives            "$HOME/.claude/skills/audit-directives"
link delegate-build              "$HOME/.claude/skills/delegate-build"
render_agents
link agents/delegate-builder.md  "$HOME/.claude/agents/delegate-builder.md"
link agents/claude-reviewer.md   "$HOME/.claude/agents/claude-reviewer.md"
link agents/researcher.md        "$HOME/.claude/agents/researcher.md"
link agents/scout.md             "$HOME/.claude/agents/scout.md"
link commands/iterate.md         "$HOME/.claude/commands/iterate.md"

if [ "$do_codex" = 1 ]; then
  echo
  echo "Codex CLI"
  link AGENT_BEHAVIOR.md "$HOME/.codex/AGENTS.md"
fi

if [ "$do_opencode" = 1 ]; then
  echo
  echo "OpenCode"
  link AGENT_BEHAVIOR.md "$HOME/.config/opencode/AGENTS.md"
fi

if [ "$do_copilot" = 1 ]; then
  echo
  echo "Copilot CLI"
  link AGENT_BEHAVIOR.md "$HOME/.copilot/copilot-instructions.md"
fi

echo
echo "$made created, $kept already in place, $removed pre-rename links removed, $refused left alone."
if [ "$refused" -gt 0 ]; then
  echo "Paths left alone hold your existing content. Fold it into your fork"
  echo "first (see SETUP.md), move the old file away, then rerun."
fi
if [ "$render_failed" = 1 ]; then
  echo "bin/roster-render failed: agents/*.md frontmatter may not match roster.conf."
fi

# doctor is the referee for the links, but it cannot see that the render failed
# — it reports on whatever the agent files currently say. So run it (not exec:
# its status is a verdict to weigh, not the last word) and let a failed render
# fail the install regardless of what doctor made of the result.
"$repo/bin/doctor"
doctor_status=$?
if [ "$render_failed" = 1 ]; then exit 1; fi
exit "$doctor_status"
