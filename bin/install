#!/usr/bin/env bash
# Creates the symlinks SETUP.md documents: the required Claude Code set by
# default, the optional harness links by flag. Renders agents/*.md frontmatter
# from roster.conf first, so the links land on current files.
# --codex also links the delegate-build skill into ~/.agents/skills and renders
# the delegate-builder, scout and researcher agent files into ~/.codex/agents.
# Those are regular files, not links (Codex refuses a symlinked agent file), so
# they do not follow a git pull by themselves. A plain run (no --codex)
# refreshes the ones an earlier run generated, but only when
# ~/.agents/skills/delegate-build links to THIS clone's delegate-build: that
# link is what says whose files they are. With generated files present and no
# such link (missing, or pointing at another clone) it prints one "not
# refreshed" row, touches nothing and does not fail; with no generated files it
# prints nothing. A plain run never creates the files or the ~/.agents link.
# Under --codex (and so --all) a path in ~/.codex/agents that bin/roster-render
# did not generate (no marker line), or that is a symlink, is an error left
# alone, and so is a refused or failed ~/.agents link: then no agent file is
# rendered at all, and the run exits non-zero.
# Before linking, removes links left by the delegate-build rename (opus-build,
# opus-builder, opus-reviewer) that still name their old target in this clone.
# Idempotent and non-clobbering:
# a link already resolving into this clone is left alone, and anything else
# occupying a target path is reported, never replaced. Exit status: a link that
# cannot be created (mkdir or ln fails) is a failure row and exits non-zero. A
# link that is refused (something else occupies the path) is reported and left
# alone; for the always-on Claude Code set doctor's required rows judge that,
# but under an explicitly requested harness flag (--codex, --opencode,
# --copilot, --all) it exits non-zero as well. Finishes by running
# bin/doctor, which is the referee for whether the install actually took —
# for the always-on Claude Code set, if this script and doctor disagree about
# a link, doctor wins; the link-failure and flag-refusal exits above stand on
# their own, since doctor rates the harness-flag links as optional.
#
# Usage: bin/install [--codex] [--opencode] [--copilot] [--all]
set -uo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

do_codex=0; do_opencode=0; do_copilot=0
for arg in "$@"; do
  case "$arg" in
    --codex)    do_codex=1 ;;
    --opencode) do_opencode=1 ;;
    --copilot)  do_copilot=1 ;;
    --all)      do_codex=1; do_opencode=1; do_copilot=1 ;;
    *) echo "usage: bin/install [--codex] [--opencode] [--copilot] [--all]" >&2; exit 2 ;;
  esac
done

made=0; kept=0; removed=0; refused=0; failed=0; flag_refused=0; render_failed=0
# 1 while linking for a harness the caller asked for by flag: a refused link
# there fails the run, where for the always-on Claude set doctor is the judge.
explicit=0
OK="  ok  "; NO="  --  "
# The ~ goes through a variable: bash 5 tilde-expands a literal ~ in the
# replacement back to $HOME, and bash 3.2 keeps a backslash-escaped one.
tilde='~'
row() { printf '  %-44s %s %s\n' "${1/#$HOME/$tilde}" "$2" "${3:-}"; }

# Stricter than doctor's into-this-clone test: a link counts only if it
# resolves to exactly the documented source. A link to some other file,
# even one inside this clone, is left alone and reported like any other
# occupant.
links_to() { # links_to <link> <absolute expected source>
  [ -L "$1" ] || return 1
  t="$(readlink "$1")"
  case "$t" in /*) ;; *) t="$(dirname "$1")/$t" ;; esac
  [ "$(cd "$(dirname "$t")" 2>/dev/null && pwd -P)/$(basename "$t")" = "$2" ]
}

# True if <link> is a symlink naming exactly "$repo/<old target>", the path a
# pre-rename install created. That target is dangling by construction, so only
# its directory is resolved, physically; a link whose directory does not
# resolve, or that names anything else (another clone, a live file in this one,
# a `..` escape), is not ours. Same test as bin/doctor's stale-link row.
is_pre_rename_link() { # is_pre_rename_link <link> <repo-relative old target>
  local t d
  [ -L "$1" ] || return 1
  t="$(readlink "$1")"
  case "$t" in
    /*) ;;
    *) d="$(CDPATH='' cd -P -- "$(dirname "$1")" 2>/dev/null && pwd -P)" || return 1
       t="$d/$t" ;;
  esac
  d="$(CDPATH='' cd -P -- "$(dirname "$t")" 2>/dev/null && pwd -P)" || return 1
  [ "$d/$(basename "$t")" = "$repo/$2" ]
}

# The delegate-build rename left three links under ~/.claude that name paths
# this clone no longer has. Remove each one that still names its old target;
# rm on a symlink acts on the link itself, so a dangling one goes too. Anything
# else at those paths is not ours, and nothing is linked there any more, so it
# is left alone without comment.
migrate_pre_rename() {
  local pair old dst found=0
  for pair in skills/opus-build:opus-build \
              agents/opus-builder.md:agents/opus-builder.md \
              agents/opus-reviewer.md:agents/opus-reviewer.md; do
    old="${pair%%:*}"; dst="$HOME/.claude/$old"
    is_pre_rename_link "$dst" "${pair#*:}" || continue
    found=1
    if rm -f -- "$dst"; then
      row "$dst" "$OK" "removed pre-rename link"; removed=$((removed+1))
    else
      row "$dst" "$NO" "pre-rename link could not be removed; left alone"; refused=$((refused+1))
    fi
  done
  [ "$found" = 1 ] || row "pre-rename links" "$OK" "none present"
}

# Returns 0 when the link is in place (created or already there), 1 when the
# path is occupied by something else (refused), 2 when it could not be created.
link() { # link <repo-relative source> <absolute target>
  local src="$repo/$1" dst="$2" err
  if links_to "$dst" "$src"; then
    row "$dst" "$OK" "already linked"; kept=$((kept+1)); return 0
  elif [ -e "$dst" ] || [ -L "$dst" ]; then
    row "$dst" "$NO" "exists and is not a link to its documented target; left alone"; refused=$((refused+1))
    [ "$explicit" = 0 ] || flag_refused=$((flag_refused+1))
    return 1
  fi
  if err="$( { mkdir -p -- "$(dirname "$dst")" && ln -s -- "$src" "$dst"; } 2>&1 )"; then
    row "$dst" "$OK" "created"; made=$((made+1)); return 0
  fi
  err="${err%%$'\n'*}"
  row "$dst" "$NO" "could not be created${err:+: $err}"; failed=$((failed+1))
  return 2
}

# agents/*.md frontmatter is generated from roster.conf, so render it before
# the links go in: a link should point at a file that already matches the
# roster. bin/roster-render prints one line per agent file; each becomes a row.
render_agents() {
  if ! r_out="$("$repo/bin/roster-render" 2>&1)"; then
    render_failed=1
    while IFS= read -r r_line; do
      [ -n "$r_line" ] || continue
      row "bin/roster-render" "$NO" "$r_line"
    done <<< "$r_out"
    return
  fi
  while IFS= read -r r_line; do
    [ -n "$r_line" ] || continue
    r_verb="${r_line%% *}"; r_rest="${r_line#* }"
    r_path="${r_rest%% *}"; r_note="${r_rest#"$r_path"}"; r_note="${r_note# }"
    row "$r_path" "$OK" "$r_verb${r_note:+ $r_note}"
  done <<< "$r_out"
}

# The Codex agent files are copies, rendered by bin/roster-render --codex, so
# each of its lines becomes a row, as render_agents does. An error line, any
# line that is not one of the known verbs, or a non-zero exit is a failed
# render, but the rows of the files that did render still show.
codex_rows() { # codex_rows <bin/roster-render output> <its exit status>
  local line verb rest path note
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    verb="${line%% *}"; rest="${line#* }"
    case "$verb" in
      rendered|unchanged|ok)
        path="${rest%% *}"; note="${rest#"$path"}"; note="${note# }"
        row "$path" "$OK" "$verb${note:+ $note}" ;;
      error)
        row "${rest%%: *}" "$NO" "${rest#*: }"; render_failed=1 ;;
      *)
        row "bin/roster-render" "$NO" "$line"; render_failed=1 ;;
    esac
  done <<< "$1"
  [ "$2" -eq 0 ] || render_failed=1
}

echo
echo "skills install — $repo"

echo
echo "Claude Code (required set)"
migrate_pre_rename
link CLAUDE.global.md            "$HOME/.claude/CLAUDE.md"
link audit-directives            "$HOME/.claude/skills/audit-directives"
link delegate-build              "$HOME/.claude/skills/delegate-build"
render_agents
link agents/delegate-builder.md  "$HOME/.claude/agents/delegate-builder.md"
link agents/claude-reviewer.md   "$HOME/.claude/agents/claude-reviewer.md"
link agents/researcher.md        "$HOME/.claude/agents/researcher.md"
link agents/scout.md             "$HOME/.claude/agents/scout.md"
link commands/iterate.md         "$HOME/.claude/commands/iterate.md"

codex_dir="$HOME/.codex/agents"
codex_skill="$HOME/.agents/skills/delegate-build"
if [ "$do_codex" = 1 ]; then
  echo
  echo "Codex CLI"
  explicit=1
  link AGENT_BEHAVIOR.md "$HOME/.codex/AGENTS.md"
  # The skill link is what marks the agent files as this clone's, so a refused
  # or failed one means no file is rendered: they would belong to no link.
  if link delegate-build "$codex_skill"; then
    c_out="$("$repo/bin/roster-render" --codex "$codex_dir" 2>&1)"; c_rc=$?
    codex_rows "$c_out" "$c_rc"
  else
    row "$codex_dir" "$NO" "agent files not rendered: the delegate-build skill link above is not in place"
  fi
  explicit=0
else
  # Without --codex nothing is created. Files a --codex run generated earlier
  # are brought up to date, so a pull that changed roster.conf or an agent body
  # reaches Codex on the next install, but only when the skill link says they
  # are this clone's. --refresh prints nothing when there is nothing to
  # refresh, and then so does this; --refresh --check is the same question
  # asked without writing ("is a generated file there?").
  if links_to "$codex_skill" "$repo/delegate-build"; then
    c_out="$("$repo/bin/roster-render" --codex "$codex_dir" --refresh 2>&1)"; c_rc=$?
    if [ -n "$c_out" ] || [ "$c_rc" -ne 0 ]; then
      echo
      echo "Codex agent files (refreshed; bin/install --codex creates them)"
      codex_rows "$c_out" "$c_rc"
    fi
  else
    c_out="$("$repo/bin/roster-render" --codex "$codex_dir" --refresh --check 2>&1)" || true
    if [ -n "$c_out" ]; then
      echo
      echo "Codex agent files"
      row "$codex_dir" "$NO" "not refreshed: they belong to another clone, or ~/.agents/skills/delegate-build does not link to this one"
    fi
  fi
fi

if [ "$do_opencode" = 1 ]; then
  echo
  echo "OpenCode"
  explicit=1
  link AGENT_BEHAVIOR.md "$HOME/.config/opencode/AGENTS.md"
  explicit=0
fi

if [ "$do_copilot" = 1 ]; then
  echo
  echo "Copilot CLI"
  explicit=1
  link AGENT_BEHAVIOR.md "$HOME/.copilot/copilot-instructions.md"
  explicit=0
fi

echo
echo "$made created, $kept already in place, $removed pre-rename links removed, $refused left alone."
if [ "$refused" -gt 0 ]; then
  echo "Paths left alone hold your existing content. Fold it into your fork"
  echo "first (see SETUP.md), move the old file away, then rerun."
fi
if [ "$flag_refused" -gt 0 ]; then
  echo "$flag_refused link(s) you asked for by flag were left alone: this run exits non-zero."
fi
if [ "$failed" -gt 0 ]; then
  echo "$failed link(s) could not be created (rows above): this run exits non-zero."
fi
if [ "$render_failed" = 1 ]; then
  echo "bin/roster-render failed: agents/*.md frontmatter or the Codex agent files may not match roster.conf."
fi

# doctor is the referee for the links, but it cannot see that the render failed
# — it reports on whatever the agent files currently say. So run it (not exec:
# its status is a verdict to weigh, not the last word) and let a failed render
# fail the install regardless of what doctor made of the result. A link that
# could not be created, or that was refused where a flag asked for it, fails it
# the same way.
"$repo/bin/doctor"
doctor_status=$?
if [ "$render_failed" = 1 ] || [ "$failed" -gt 0 ] || [ "$flag_refused" -gt 0 ]; then exit 1; fi
exit "$doctor_status"
