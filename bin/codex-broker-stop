#!/usr/bin/env bash
# Stop the Codex plugin's idle app-server brokers for the folders named, or for
# folders that no longer exist.
#
# Usage: bin/codex-broker-stop [--dry-run] <dir>...
#        bin/codex-broker-stop [--dry-run] --gone
#   <dir>...  stop the brokers started for these folders (a worktree a GPT lane
#             ran in). --gone stops the brokers whose folder was deleted.
#   Exit 0 when nothing is left to stop, 3 when a broker was left running (a
#   client is connected, or its state could not be read), 2 on a usage error.
#
# Why this exists: the codex plugin (1.0.6) starts one detached broker per
# working folder, and its SessionEnd hook stops only the broker of the folder the
# session ended in (session-lifecycle-hook.mjs). A lane run in a worktree leaves
# its broker, app server and code-mode host up for good; on 2026-11-24 that was
# 79 brokers, about 4 GB of summed RSS. Stopping one is safe when it is idle: the
# next Codex run in that folder starts a new one (broker-lifecycle.mjs,
# ensureBrokerSession).
#
# An idle broker holds exactly 4 unix sockets: 3 to its app server and the
# listener. A connected client is a fifth (checked on macOS by opening one). Any
# other count means a client or an unreadable process, and is left alone.
set -uo pipefail

usage() { echo "usage: bin/codex-broker-stop [--dry-run] (<dir>... | --gone)" >&2; exit 2; }

dry=0; gone=0; dirs=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1; shift ;;
    --gone)    gone=1; shift ;;
    -*)        usage ;;
    '')        usage ;;
    *)         dirs+=("$1"); shift ;;
  esac
done
if [ "$gone" -eq 1 ]; then [ "${#dirs[@]}" -eq 0 ] || usage; else [ "${#dirs[@]}" -gt 0 ] || usage; fi
command -v lsof >/dev/null || { echo "codex-broker-stop: lsof not found" >&2; exit 3; }

# Every spelling of a folder the plugin may have passed as --cwd: as given,
# physical, and its git toplevel (the plugin resolves the workspace root).
spellings() {
  local d="$1" top
  printf '%s\n' "${d%/}"
  if [ -d "$d" ]; then
    (CDPATH='' cd -P -- "$d" && pwd -P)
    if top="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)"; then printf '%s\n' "$top"; fi
  fi
}

wanted=""
if [ "$gone" -eq 0 ]; then
  for d in "${dirs[@]}"; do
    case "$d" in /*) ;; *) d="$PWD/$d" ;; esac
    wanted="$wanted$(spellings "$d")"$'\n'
  done
fi

is_wanted() {
  if [ "$gone" -eq 1 ]; then [ ! -d "$1" ]; return; fi
  printf '%s' "$wanted" | grep -Fxq -- "$1"
}

left=0; seen=0
# pid, then the command; a broker's command carries its folder between --cwd and
# --pid-file.
while read -r pid cmd; do
  # The process itself must be node running the broker script: a shell whose text
  # merely quotes a broker command line is not one.
  first="${cmd%% *}"; rest="${cmd#* }"; script="${rest%% *}"
  [ "${first##*/}" = node ] && [ "${script##*/}" = app-server-broker.mjs ] || continue
  case "$rest" in *" serve "*" --cwd "*" --pid-file "*) ;; *) continue ;; esac
  cwd="${cmd#* --cwd }"; cwd="${cwd%% --pid-file *}"
  is_wanted "$cwd" || continue
  seen=$((seen+1))
  n="$(lsof -nP -a -U -p "$pid" 2>/dev/null | awk 'NR>1' | wc -l | tr -d ' ')"
  if [ "$n" != 4 ]; then
    echo "left running: $pid ($n unix sockets, not 4: a client is connected, or unreadable) $cwd"
    left=$((left+1)); continue
  fi
  if [ "$dry" -eq 1 ]; then echo "would stop: $pid $cwd"; continue; fi
  if ! kill -TERM "$pid" 2>/dev/null; then
    kill -0 "$pid" 2>/dev/null && { echo "left running: $pid (could not signal) $cwd"; left=$((left+1)); }
    continue
  fi
  i=0
  while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i+1)); done
  if kill -0 "$pid" 2>/dev/null; then
    echo "left running: $pid (still up 5 s after the stop request) $cwd"; left=$((left+1))
  else
    echo "stopped: $pid $cwd"
  fi
done <<EOF
$(ps -axww -o pid=,command= | grep '[a]pp-server-broker\.mjs serve ')
EOF

[ "$seen" -gt 0 ] || echo "no broker found"
[ "$left" -eq 0 ] || exit 3
