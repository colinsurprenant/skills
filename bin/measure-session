#!/usr/bin/env python3
"""Measure one Claude Code session: list-price cost, and where the main loop's
tokens went.

Usage:
  bin/measure-session cost   [--json] [--no-dedup] [--include-siblings] <main.jsonl>
  bin/measure-session phases [--json] [--top N] <main.jsonl>
  bin/measure-session --selftest

<main.jsonl> is a main-loop transcript, ~/.claude/projects/<key>/<uuid>.jsonl.
Its subagents live beside it in <key>/<uuid>/subagents/agent-*.jsonl, each with
an agent-*.meta.json naming its agentType, description and the toolUseId of the
Agent call that spawned it. Other <uuid>.jsonl files in the same project dir
are separate sessions and are left out unless --include-siblings asks for them.

Record shape (Claude Code >= 2.1): one JSON object per line; the ones that
matter have type "assistant" and carry the API response under "message", with
"message.id", "message.model" and "message.usage". A single API response is
written out once per content block, so the same message id appears on several
records, each repeating the identical usage object. Those are collapsed by
message id (last record wins); --no-dedup sums raw records instead, which is
what a naive count reports and roughly doubles every number.

cost: every transcript priced at RATES, with a per-model and per-transcript
breakdown and the main/subagent rollup. Each message's cache writes are
priced by TTL: the tokens its usage reports as 1-hour writes
(cache_creation.ephemeral_1h_input_tokens) at the 1-hour rate, the rest of
cache_creation_input_tokens at the 5-minute rate; a message without that
breakdown is priced wholly at the 5-minute rate. The per-model table splits
the cache write line in two when a model has 1-hour writes. A model with no
list rate (see rate_for()) is warned about once on stderr, listed under
"unpriced" in the JSON, and left out of totals; text tables print "?" for a
cost with nothing priced and a trailing "?" on a lower bound.

phases: main loop only.
  - Phase of each assistant message: the most recent boundary (see classify()).
    "director" and "commit" are one-shot: they label only the message that
    runs the command, and the next message returns to the phase before it.
    A director call in a turn with more than DIRECTOR_RIDE_ALONG_OUT tokens
    of thinking is a ride-along: the turn keeps its surrounding phase and
    is counted in "ride_along" (also per message in the timeline).
  - Admitted tokens: a message's cache_creation_input_tokens is what that turn
    newly wrote to cache. It is split in three. When cache_read falls short of
    the previous message's cache_read + cache_creation (TTL expiry, model
    switch, compaction), the shortfall is prefix written again, not new
    content: it goes to "cache-rebuild", capped at the total. The previous
    message's output_tokens (thinking included; the transcripts show it
    re-admitted on the next turn) go to "assistant-output", capped at what is
    left. The rest is
    spread over the user-side content that arrived since the previous message
    (tool_result blocks, subagent hand-backs, task notifications, skill
    bodies, prompts) in proportion to character count, bucketed by the tool
    that produced it. This is an approximation: characters are not tokens,
    and attachments (reminders, hook output) are not measured, so their share
    lands on whatever content is present; a turn with no measured content
    puts its remainder in "other" (the first turn's system prompt lands there).
    Buckets are rounded by largest remainder, so each row sums to "admitted".
  - Work orders: one row per Agent, Task or Workflow call. The join to a
    subagent transcript uses its meta.json, else the agentId the Agent call's
    own tool_result reports (toolUseResult). Main-loop cost runs from the dispatch
    message through the message that consumes the result (the hand-back for a
    background agent). Windows of concurrent agents overlap, so the column
    does not sum to the main-loop total.
  - Top admissions: the largest single pieces of user-side content by
    characters, hand-backs and skill bodies included.
  - Costs are priced as in cost. A closing note states how many cache-write
    tokens each model wrote at the 1-hour TTL, for the main loop's messages.
"""

import argparse
import glob
import json
import os
import re
import sys
from collections import OrderedDict
from datetime import datetime, timezone

PROG = "measure-session"

# USD per million tokens: (uncached input, cache read, 5-minute cache write,
# 1-hour cache write, output). List prices from
# https://platform.claude.com/docs/en/about-claude/pricing, checked 2026-09-30.
RATES = {
    "claude-fable-5-1": (10.0, 0.25, 12.50, 20.0, 50.0),
    # Fable 5 is a separate, older model: its cache read is the standard 0.1x.
    "claude-fable-5": (10.0, 1.00, 12.50, 20.0, 50.0),
    "claude-opus-4-7": (5.0, 0.50, 6.25, 10.0, 25.0),
    "claude-opus-5": (5.0, 0.50, 6.25, 10.0, 25.0),
    "claude-opus-5-5": (4.0, 0.20, 5.00, 8.0, 20.0),
    "claude-sonnet-5": (2.0, 0.20, 2.50, 4.0, 10.0),
    "claude-sonnet-5-5": (2.0, 0.20, 2.50, 4.0, 10.0),
    "claude-haiku-4-5": (1.0, 0.10, 1.25, 2.0, 5.0),
}

FIELDS = (
    ("uncached input", "input_tokens"),
    ("cache read", "cache_read_input_tokens"),
    ("cache write", "cache_creation_input_tokens"),
    ("output", "output_tokens"),
)

BUCKETS = ("Agent", "Bash", "Read", "Grep/Glob", "Skill", "other",
           "assistant-output", "cache-rebuild")

PHASE_ORDER = ("plan", "build", "builder-review", "lane", "triage",
               "director", "commit")
ONE_SHOT = ("director", "commit")
# A director call in a turn whose own output is above this many tokens rode
# along on thinking the session would have done anyway; the turn keeps its
# surrounding phase and is counted under "ride_along" instead.
DIRECTOR_RIDE_ALONG_OUT = 3000
DISPATCH_TOOLS = ("Agent", "Task", "Workflow")
MARKER_PHASE = {"1": "plan", "2": "build", "3": "builder-review",
                "4": "lane", "5": "triage"}
# A "Phase N" mention after one of these words in the same sentence names a
# phase still to come ("waiting ... before Phase 3 review") or one passed over
# ("skipping Phase 4"), not the current one.
FORWARD_REF = re.compile(r"\b(before|until|once|after|since|waiting|wait|"
                         r"preparing|prepare|ahead|next|when|"
                         r"skip|skipping|skipped)\b", re.I)
# Names the build workflow goes by, the current one first and the ones older
# transcripts carry after it. A rename is one edit here, with the old name kept
# so past sessions still measure the same.
BUILD_SKILLS = ("delegate-build", "opus-build")
BUILDER_AGENTS = ("delegate-builder", "opus-builder")
REVIEWER_AGENTS = ("claude-reviewer", "opus-reviewer")
LANE_WRAPPERS = ("claude-review.sh", "kimi-review.sh",
                 "opus-review.sh", "k3-review.sh")
PLAN_AGENTS = ("scout", "Explore", "general-purpose", "Plan")
READ_ONLY_CMDS = {"cat", "sed", "grep", "rg", "ls", "head", "tail", "find",
                  "wc", "awk", "tree", "stat", "file", "cd", "echo", "date",
                  "pwd", "which"}
READ_ONLY_GIT = {"log", "status", "branch", "show", "diff", "rev-parse"}
READ_ONLY_DIRECTOR = {"status", "render", "--help", "help"}
NULL_REDIRECTS = re.compile(r"\d?>&\d|\d?>\s*/dev/null")
# Matched against the basename of the program a shell segment runs, so reading
# a wrapper's tee'd report ($TMPDIR/kimi-review-XXXXXX) does not open a lane.
LANE_WRAPPER = re.compile(r"^(?:%s)$" % "|".join(map(re.escape, LANE_WRAPPERS)))
REVIEW_WRAPPER = re.compile(r"review[\w.-]*\.sh$")
LAUNCHERS = {"env", "nohup", "exec", "bash", "sh", "zsh", "time", "command",
             "timeout"}
GIT_COMMIT = re.compile(r"\bgit\s+(?:-C\s+\S+\s+)?(?:commit|push)\b")
SCRATCH_PATH = re.compile(r"^(?:/private)?/tmp/|/scratchpad/")
HANDBACK = re.compile(r'<agent-message from="([^"]+)"')
NOTIFY_ID = re.compile(r"<tool-use-id>([^<]+)</tool-use-id>")


def rate_for(model):
    """Exact match first, then a known id plus a date suffix.

    Covers dated ids ("claude-opus-5-20260401") and context suffixes
    ("claude-opus-5[1m]"); returns None for a model we have no list price for,
    including an unknown point release ("claude-opus-5-1") of a known family.
    """
    if model in RATES:
        return RATES[model]
    base = model.split("[", 1)[0]
    if base in RATES:
        return RATES[base]
    dated = re.match(r"^(.*)-\d{8}$", base)
    if dated and dated.group(1) in RATES:
        return RATES[dated.group(1)]
    return None


def parse_ts(value):
    if not isinstance(value, str) or not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def read_records(path):
    """Yield (lineno, record) for every JSON object line; warn on the rest."""
    try:
        handle = open(path, "r", encoding="utf-8", errors="replace")
    except OSError as exc:
        sys.exit("%s: cannot read %s: %s" % (PROG, path, exc))
    with handle:
        for lineno, line in enumerate(handle, 1):
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except ValueError:
                print("%s: %s:%d: not JSON, skipped" % (PROG, path, lineno),
                      file=sys.stderr)
                continue
            if isinstance(rec, dict):
                yield lineno, rec


def usage_of(rec):
    message = rec.get("message")
    if not isinstance(message, dict):
        return None
    usage = message.get("usage")
    if usage is None and isinstance(rec.get("usage"), dict):
        usage = rec["usage"]  # older transcripts put it on the record
    return usage if isinstance(usage, dict) else None


def load_messages(path, dedup=True):
    """Return (messages, stats). messages maps a key -> (model, usage)."""
    messages = OrderedDict()
    stats = {"assistant_records": 0, "no_usage": 0, "first": None,
             "last": None}
    for lineno, rec in read_records(path):
        ts = parse_ts(rec.get("timestamp"))
        if ts is not None:
            if stats["first"] is None or ts < stats["first"]:
                stats["first"] = ts
            if stats["last"] is None or ts > stats["last"]:
                stats["last"] = ts
        if rec.get("type") != "assistant":
            continue
        stats["assistant_records"] += 1
        usage = usage_of(rec)
        if usage is None:
            stats["no_usage"] += 1
            continue
        message = rec["message"]
        model = message.get("model") or rec.get("model") or "(unknown)"
        key = message.get("id") or rec.get("uuid") or lineno
        if not dedup:
            key = lineno
        if key in messages:
            del messages[key]  # keep the last record for this id
        messages[key] = (model, usage)
    return messages, stats


def tok(usage, field):
    value = usage.get(field, 0)
    return value if isinstance(value, int) else 0


WARNED = set()


def usd(model, usage):
    """List-price cost of one message, or None for an unpriced model. A message
    with no tokens costs 0 whatever its model (synthetic error records)."""
    if not any(tok(usage, f) for _, f in FIELDS):
        return 0.0
    rates = rate_for(model)
    if rates is None:
        if model not in WARNED:
            WARNED.add(model)
            print("%s: warning: %s has no list rate; its cost shows as ? and "
                  "is left out of totals" % (PROG, model), file=sys.stderr)
        return None
    tokens = OrderedDict((f, tok(usage, f)) for _, f in FIELDS)
    return sum(n * rate for _, n, rate in
               priced_lines(tokens, one_hour_writes(usage), rates))


def fmt_usd(value, partial=False, width=9):
    """'?' for a cost with nothing priced, a trailing '?' on a lower bound."""
    text = "?" if value is None else "%.4f%s" % (value, "?" if partial else "")
    return "%*s" % (width, text)


def one_hour_writes(usage):
    """Cache-write tokens this message wrote at the 1-hour TTL, 0 when usage
    has no cache_creation breakdown; never more than its total writes."""
    detail = usage.get("cache_creation")
    if isinstance(detail, dict):
        value = detail.get("ephemeral_1h_input_tokens", 0)
        if isinstance(value, int):
            return min(max(value, 0),
                       max(tok(usage, "cache_creation_input_tokens"), 0))
    return 0


def priced_lines(tokens, hour, rates):
    """[(label, tokens, USD per token)] for FIELDS token counts with hour of
    the cache writes at the 1-hour TTL: the cache write line is split into its
    5-minute and 1-hour parts when hour is non-zero. rates is a RATES tuple,
    or None for an unpriced model (every rate then None)."""
    rate = (lambda i: None) if rates is None else (lambda i: rates[i] / 1e6)
    written = tokens["cache_creation_input_tokens"]
    if hour:
        writes = [("cache write 5m", written - hour, rate(2)),
                  ("cache write 1h", hour, rate(3))]
    else:
        writes = [("cache write", written, rate(2))]
    return ([("uncached input", tokens["input_tokens"], rate(0)),
             ("cache read", tokens["cache_read_input_tokens"], rate(1))]
            + writes + [("output", tokens["output_tokens"], rate(4))])


def summarize(messages):
    """Per-model token totals and cost for one transcript."""
    by_model = OrderedDict()
    for model, usage in messages.values():
        row = by_model.setdefault(model, {
            "messages": 0, "tokens": OrderedDict((f, 0) for _, f in FIELDS),
            "usd": 0.0, "priced": True, "cache_write_1h": 0})
        row["messages"] += 1
        for _, field in FIELDS:
            row["tokens"][field] += tok(usage, field)
        cost = usd(model, usage)
        if cost is None:
            row["priced"] = False
        row["usd"] += cost or 0.0
        row["cache_write_1h"] += one_hour_writes(usage)
    return by_model


def subagent_files(main_path):
    """[(jsonl, meta)] for the session's subagents, meta {} when missing."""
    stem = os.path.splitext(main_path)[0]
    found = []
    pattern = os.path.join(glob.escape(stem), "subagents", "agent-*.jsonl")
    for path in sorted(glob.glob(pattern)):
        meta_path = path[:-len(".jsonl")] + ".meta.json"
        meta = {}
        try:
            with open(meta_path, "r", encoding="utf-8") as handle:
                meta = json.load(handle)
        except (OSError, ValueError):
            print("%s: no readable meta for %s" % (PROG, path), file=sys.stderr)
        found.append((path, meta if isinstance(meta, dict) else {}))
    return found


def transcript_set(main_path, include_siblings):
    """[(role, path, meta)] for the main loop, its subagents, and optionally
    the other sessions in the same project dir with theirs."""
    mains = [("main", main_path)]
    if include_siblings:
        pattern = os.path.join(glob.escape(os.path.dirname(main_path)), "*.jsonl")
        for path in sorted(glob.glob(pattern)):
            if os.path.abspath(path) != os.path.abspath(main_path):
                mains.append(("sibling", path))
    out = []
    for role, path in mains:
        out.append((role, path, {}))
        sub_role = "subagent" if role == "main" else "sibling-subagent"
        out.extend((sub_role, p, m) for p, m in subagent_files(path))
    return out


def fmt_span(first, last):
    if first is None or last is None:
        return "no timestamps found"
    seconds = int((last - first).total_seconds())
    h, rem = divmod(max(seconds, 0), 3600)
    m, s = divmod(rem, 60)
    iso = "%Y-%m-%dT%H:%M:%SZ"
    return "%s -> %s (%dh%02dm%02ds)" % (
        first.astimezone(timezone.utc).strftime(iso),
        last.astimezone(timezone.utc).strftime(iso),
        h, m, s)


def cost_data(main_path, dedup, include_siblings):
    rows = []
    rollup = OrderedDict()
    for role, path, meta in transcript_set(main_path, include_siblings):
        messages, stats = load_messages(path, dedup)
        by_model = summarize(messages)
        usable = stats["assistant_records"] - stats["no_usage"]
        rows.append({
            "role": role, "path": path,
            "name": os.path.splitext(os.path.basename(path))[0],
            "agent_type": meta.get("agentType"),
            "description": meta.get("description"),
            "tool_use_id": meta.get("toolUseId"),
            "messages": len(messages),
            "duplicates_collapsed": max(usable - len(messages), 0),
            "no_usage": stats["no_usage"],
            "span": fmt_span(stats["first"], stats["last"]),
            "usd": sum(r["usd"] for r in by_model.values()),
            "unpriced": [m for m, r in by_model.items() if not r["priced"]],
            "by_model": by_model})
        for model, row in by_model.items():
            agg = rollup.setdefault(model, {
                "messages": 0, "tokens": OrderedDict((f, 0) for _, f in FIELDS),
                "usd": 0.0, "priced": True, "cache_write_1h": 0})
            agg["priced"] = agg["priced"] and row["priced"]
            agg["messages"] += row["messages"]
            agg["usd"] += row["usd"]
            agg["cache_write_1h"] += row["cache_write_1h"]
            for field, value in row["tokens"].items():
                agg["tokens"][field] += value

    def total(roles):
        return sum(r["usd"] for r in rows if r["role"] in roles)
    return {
        "main": main_path, "dedup": dedup, "transcripts": rows,
        "by_model": rollup,
        "main_usd": total(("main",)),
        "subagents_usd": total(("subagent",)),
        "siblings_usd": total(("sibling", "sibling-subagent")),
        "total_usd": sum(r["usd"] for r in rows),
        "unpriced": [m for m, r in rollup.items() if not r["priced"]]}


def print_cost(data):
    print("%-26s %-20s %5s %10s  %s" % ("transcript", "type", "msgs", "USD",
                                        "models / description"))
    for row in data["transcripts"]:
        models = ", ".join("%s x%d" % (m, r["messages"])
                           for m, r in row["by_model"].items())
        label = row["agent_type"] or row["role"]
        extra = " -- %s" % row["description"] if row["description"] else ""
        cost = fmt_usd(None if row["unpriced"] and len(row["unpriced"]) ==
                       len(row["by_model"]) else row["usd"],
                       bool(row["unpriced"]), 10)
        print("%-26s %-20s %5d %s  %s%s" % (
            row["name"][:26], label[:20], row["messages"], cost,
            models, extra))
    print()
    for model, row in data["by_model"].items():
        print("%s  (%d msgs)" % (model, row["messages"]))
        for label, tokens, rate in priced_lines(
                row["tokens"], row["cache_write_1h"], rate_for(model)):
            if rate is None:
                print("  %-14s %15s tok" % (label, "{:,}".format(tokens)))
                continue
            print("  %-14s %15s tok  @ $%6.2f/M  $%9.4f" % (
                label, "{:,}".format(tokens), rate * 1e6, tokens * rate))
        if not row["priced"]:
            print("  unknown model: no list rate, not priced")
        else:
            print("  %-14s %45s$%9.4f" % ("subtotal", "", row["usd"]))
        print()
    main = data["transcripts"][0]
    subs = [r for r in data["transcripts"] if r["role"] == "subagent"]
    mark = lambda rows: "?" if any(r["unpriced"] for r in rows) else ""
    print("main       $%9.4f%s  %d msgs  %s" % (
        data["main_usd"], mark([main]), main["messages"], main["span"]))
    print("subagents  $%9.4f%s  %d transcripts, %d msgs" % (
        data["subagents_usd"], mark(subs), len(subs),
        sum(r["messages"] for r in subs)))
    if data["siblings_usd"]:
        print("siblings   $%9.4f" % data["siblings_usd"])
    print("TOTAL      $%9.4f%s" % (data["total_usd"],
                                   "?" if data["unpriced"] else ""))
    collapsed = sum(r["duplicates_collapsed"] for r in data["transcripts"])
    if data["dedup"] and collapsed:
        print("note: %d duplicate assistant records collapsed by message id"
              % collapsed)


def print_ttl_notes(one_hour):
    for model, row in one_hour.items():
        print("note: %s wrote %s cache tokens at the 1-hour TTL%s" % (
            model, "{:,}".format(row["cache_write_1h"]),
            ", priced at the 1-hour rate" if row["priced"]
            else " (no list rate)"))


# --- phases -----------------------------------------------------------------

def text_of(content):
    """Character payload of a tool_result content or a user message body."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "".join(b.get("text", "") for b in content
                       if isinstance(b, dict) and b.get("type") == "text")
    return ""


def load_timeline(path):
    """Assistant messages in order, each with the user-side items that arrived
    since the previous one, plus a tool_use id -> call map."""
    messages = OrderedDict()
    tools = {}
    pending = []
    for _, rec in read_records(path):
        kind = rec.get("type")
        if kind == "user":
            pending.extend(user_items(rec, pending))
            continue
        if kind != "assistant":
            continue
        usage = usage_of(rec)
        message = rec["message"] if isinstance(rec.get("message"), dict) else {}
        key = message.get("id") or rec.get("uuid")
        if key not in messages:
            messages[key] = {"id": key, "blocks": [], "inputs": pending,
                             "model": "(unknown)", "usage": {}}
            pending = []
        msg = messages[key]
        msg["model"] = message.get("model") or msg["model"]
        if usage is not None:
            msg["usage"] = usage
        for block in message.get("content") or []:
            if not isinstance(block, dict):
                continue
            msg["blocks"].append(block)
            if block.get("type") == "tool_use":
                tools[block.get("id")] = {"name": block.get("name", "?"),
                                          "input": block.get("input") or {},
                                          "msg": key}
    return list(messages.values()), tools


def user_items(rec, pending):
    """Measured user-side content of one user record. A lone tool_result
    carries the record's toolUseResult agentId / isAsync, when present."""
    message = rec.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    if isinstance(content, str):
        return [text_item(content, rec.get("isMeta"), pending)]
    if not isinstance(content, list):
        return []
    result = rec.get("toolUseResult")
    lone = sum(isinstance(b, dict) and b.get("type") == "tool_result"
               for b in content) == 1 and isinstance(result, dict)
    items = []
    for block in content:
        if not isinstance(block, dict):
            continue
        if block.get("type") == "tool_result":
            items.append({"kind": "tool_result",
                          "tool_use_id": block.get("tool_use_id"),
                          "chars": len(text_of(block.get("content")))})
            if lone and result.get("agentId"):
                items[-1].update(agent_id=result["agentId"],
                                 is_async=result.get("isAsync"))
        elif block.get("type") == "text":
            items.append(text_item(block.get("text", ""), rec.get("isMeta"),
                                   pending + items))
    return items


def text_item(text, is_meta, before):
    """Classify a user text: subagent hand-back, task notification, the body
    of a skill whose tool_result just arrived, or anything else."""
    item = {"kind": "text", "chars": len(text)}
    handback = HANDBACK.search(text[:400])
    if handback:
        item.update(kind="handback", agent_id=handback.group(1))
    elif text.lstrip().startswith("<task-notification>"):
        found = NOTIFY_ID.search(text)
        item.update(kind="notification",
                    tool_use_id=found.group(1) if found else None)
    elif is_meta and before and before[-1]["kind"] == "tool_result":
        item.update(kind="skill_body", tool_use_id=before[-1]["tool_use_id"])
    return item


def bucket_for(tool_name):
    if tool_name in DISPATCH_TOOLS:
        return "Agent"
    if tool_name in ("Bash", "Read", "Skill"):
        return tool_name
    if tool_name in ("Grep", "Glob"):
        return "Grep/Glob"
    return "other"


def link_agents(messages, agent_meta):
    """Fill a subagent's missing toolUseId (no meta.json) from the agentId its
    Agent call's own tool_result reports."""
    launched = {}
    for msg in messages:
        for item in msg["inputs"]:
            if item["kind"] == "tool_result" and item.get("agent_id"):
                launched[item["agent_id"]] = item["tool_use_id"]
    for meta in agent_meta:
        if not meta.get("toolUseId") and meta["agentId"] in launched:
            meta["toolUseId"] = launched[meta["agentId"]]


def resolve_items(messages, tools, agent_meta):
    """Attach the originating tool call to every user-side item."""
    by_agent = {m.get("agentId"): m for m in agent_meta}
    for msg in messages:
        for item in msg["inputs"]:
            if item["kind"] == "handback":
                meta = by_agent.get(item["agent_id"], {})
                item["tool_use_id"] = meta.get("toolUseId")
            call = tools.get(item.get("tool_use_id"))
            item["tool"] = call["name"] if call else None
            if item["kind"] == "skill_body" and not call:
                item["tool"] = "Skill"
            item["bucket"] = bucket_for(item["tool"]) if item["tool"] else "other"


def deliveries(messages, tools, agent_meta):
    """tool_use id -> index of the message that consumes its real result:
    the hand-back or notification of a background call, else its tool_result."""
    background = {m.get("toolUseId") for m in agent_meta
                  if m.get("requestShape") == "background"}
    for tid, call in tools.items():
        if call["name"] == "Workflow" or (call["name"] == "Bash" and
                                          call["input"].get("run_in_background")):
            background.add(tid)
    final, direct = {}, {}
    for idx, msg in enumerate(messages):
        for item in msg["inputs"]:
            tid = item.get("tool_use_id")
            if not tid:
                continue
            if item.get("is_async"):
                background.add(tid)
            if item["kind"] in ("handback", "notification"):
                final.setdefault(tid, idx)
            elif item["kind"] == "tool_result":
                direct.setdefault(tid, idx)
    for tid, idx in direct.items():
        if tid not in background:
            final.setdefault(tid, idx)
    return final


def bash_segments(command):
    return [s.strip() for s in re.split(r";|&&|\|\||\||\n", command) if s.strip()]


def command_words(segment):
    """A shell segment's words with leading VAR=value assignments dropped."""
    words = segment.split()
    while words and re.match(r"^[A-Za-z_]\w*=", words[0]):
        words.pop(0)
    return words


def inspects_only(words):
    """True when one command, by its verb and subcommand, changes nothing."""
    verb, sub = words[0], (words[1] if len(words) > 1 else "")
    if verb == "sed" and any(w.startswith("-i") for w in words):
        return False
    return (verb in READ_ONLY_CMDS or
            verb == "git" and sub in READ_ONLY_GIT or
            verb == "go" and sub in ("version", "env") or
            verb == "director" and (sub in READ_ONLY_DIRECTOR or
                                    "--help" in words))


def is_read_only(command):
    """True for a Bash command that only inspects, with at least one pipeline
    that starts by reading a file (a director or git query alone is not a
    read, and pipe stages after the first are filters)."""
    if ">" in NULL_REDIRECTS.sub("", command):
        return False
    reads = 0
    for pipeline in re.split(r";|&&|\|\||\n", command):
        stages = [command_words(s) for s in pipeline.split("|") if s.strip()]
        stages = [w for w in stages if w]
        if not stages:
            continue
        if not all(inspects_only(w) for w in stages):
            return False
        reads += stages[0][0] in READ_ONLY_CMDS and \
            stages[0][0] not in ("cd", "echo", "date", "pwd", "which")
    return reads > 0


def invoked(command):
    """Basename of the program each shell segment runs, past env / sh /
    timeout style launchers and VAR=value assignments."""
    for segment in bash_segments(command):
        words = command_words(segment)
        while words and (words[0] in LAUNCHERS or words[0].startswith("-") or
                         re.match(r"^(?:[A-Za-z_]\w*=|\d+[smhd]?$)", words[0])):
            words.pop(0)
        if words:
            yield os.path.basename(words[0].strip("\"'"))


def lane_launch(command, inp):
    """True when a Bash command invokes a lane wrapper (not reads its report)."""
    return any(LANE_WRAPPER.search(p) or (inp.get("run_in_background") and
                                          REVIEW_WRAPPER.search(p))
               for p in invoked(command))


def builds(name, inp):
    """A dispatch of build work: a builder agent (BUILDER_AGENTS), or a Workflow
    run whose inline script names one (or that has no inline script)."""
    if name == "Workflow":
        script = inp.get("script")
        return not isinstance(script, str) or \
            any(a in script for a in BUILDER_AGENTS)
    return str(inp.get("subagent_type", "")) in BUILDER_AGENTS


def marker_phase(text):
    """Phase named by the last present-tense "Phase N" mention, or None."""
    phase = None
    for sentence in re.split(r"(?<=[.!?])\s+|\n", text):
        for hit in re.finditer(r"Phase ([1-5])", sentence):
            if not FORWARD_REF.search(sentence[:hit.start()]):
                phase = MARKER_PHASE[hit.group(1)]
    return phase


def message_signals(msg, in_plan):
    """Candidate (priority, phase, reason) boundaries opened by this message's
    own blocks, plus the tool ids whose consumption opens a later phase. Plan
    signals count only while the session is still in plan."""
    found, watch, ride = [], {}, False
    for block in msg["blocks"]:
        if block.get("type") == "text":
            phase = marker_phase(block.get("text", ""))
            if phase and (phase != "plan" or in_plan):
                found.append((1, phase, "text marker"))
        if block.get("type") != "tool_use":
            continue
        name, inp, tid = block.get("name"), block.get("input") or {}, block.get("id")
        agent_type = str(inp.get("subagent_type", ""))
        command = str(inp.get("command", "")) if name == "Bash" else ""
        dispatch = name in DISPATCH_TOOLS
        if dispatch and builds(name, inp):
            found.append((2, "build", "builder dispatch"))
            watch[tid] = "builder-review"
        elif name in ("Write", "Edit", "MultiEdit", "NotebookEdit") and \
                not SCRATCH_PATH.search(str(inp.get("file_path", ""))):
            found.append((2, "build", "main-loop repo write"))
        elif dispatch and (agent_type.startswith("codex:") or
                           agent_type in REVIEWER_AGENTS):
            found.append((4, "lane", "review agent"))
            watch[tid] = "triage"
        elif dispatch and (agent_type in PLAN_AGENTS or name == "Workflow"):
            if in_plan:
                found.append((3, "plan", "scout dispatch"))
        elif name == "Skill" and inp.get("skill") in BUILD_SKILLS:
            if in_plan:
                found.append((3, "plan", "build skill activation"))
        elif in_plan and (name in ("Read", "Grep", "Glob") or
                          (command and is_read_only(command))):
            found.append((3, "plan", "pre-build read"))
        elif name == "Skill" and inp.get("skill") == "codex:rescue":
            found.append((4, "lane", "codex:rescue skill"))
        elif command and lane_launch(command, inp):
            found.append((4, "lane", "review wrapper"))
            watch[tid] = "triage"
        elif command and any(GIT_COMMIT.search(s) for s in bash_segments(command)):
            found.append((5, "commit", "git commit/push"))
        elif command and any(s.startswith("director ") for s in bash_segments(command)):
            if thinking_output(msg) > DIRECTOR_RIDE_ALONG_OUT:
                ride = True
            else:
                found.append((5, "director", "director command"))
    return found, watch, ride


def thinking_output(msg):
    """Output tokens net of the tool_use inputs, which output_tokens counts:
    a long emit body alone must not read as a thinking turn (4 chars/token)."""
    inputs = sum(len(json.dumps(b.get("input", {}), separators=(",", ":")))
                 for b in msg["blocks"] if b.get("type") == "tool_use")
    return tok(msg["usage"], "output_tokens") - inputs // 4


def classify(messages, consumed_at):
    """Label every message with the phase of the most recent boundary.

    Priority within one message (lowest number wins): 1 a present-tense
    "Phase N" text marker; 2 a builder dispatch (Agent, Task or Workflow) or
    main-loop repo write, then consuming a builder's result; 3 plan signals,
    only while still in plan (before any build, lane or review boundary);
    4 a lane launch (codex, a reviewer agent, a review wrapper), then consuming
    a lane's result, which opens triage; 5 commit, then director. Before any
    boundary the phase is plan. commit and director are one-shot: they label
    their own message only, and the phase before them carries on. A director
    call inside a turn with more than DIRECTOR_RIDE_ALONG_OUT output tokens is
    a ride-along, not a boundary: the turn was going to happen without it.
    """
    phase, watching = "plan", {}
    for idx, msg in enumerate(messages):
        found, watch, ride = message_signals(msg, phase == "plan")
        for tid, opens in watching.items():
            if consumed_at.get(tid) == idx:
                rank = 2.5 if opens == "builder-review" else 4.5
                found.append((rank, opens, "result consumed"))
        watching.update(watch)
        if ride and not found:
            msg["ride_along"] = True
        label = phase
        if found:
            _, label, reason = min(found, key=lambda f: f[0])
            msg["reason"] = reason
            if label not in ONE_SHOT:
                phase = label
        msg["phase"] = label


def attribute(messages):
    """Split each message's cache writes over cache-rebuild, assistant-output
    and the buckets of the content that arrived since the previous message."""
    prev_out, prev_cached = 0, None
    for msg in messages:
        usage = msg["usage"]
        written = tok(usage, "cache_creation_input_tokens")
        cached = tok(usage, "cache_read_input_tokens")
        split = OrderedDict((b, 0.0) for b in BUCKETS)
        if prev_cached is not None:
            split["cache-rebuild"] = float(min(max(prev_cached - cached, 0),
                                               written))
        new = written - split["cache-rebuild"]
        split["assistant-output"] = float(min(prev_out, new))
        rest = new - split["assistant-output"]
        chars = sum(i["chars"] for i in msg["inputs"])
        if chars:
            for item in msg["inputs"]:
                split[item["bucket"]] += rest * item["chars"] / chars
        else:
            split["other"] += rest
        msg["admitted"] = written
        msg["split"] = split
        msg["usd"] = usd(msg["model"], usage)
        if any(tok(usage, f) for _, f in FIELDS):
            prev_out, prev_cached = tok(usage, "output_tokens"), cached + written


def lr_round(values, total):
    """Round to integers summing to total, by largest remainder."""
    out = OrderedDict((k, int(v)) for k, v in values.items())
    order = sorted(values, key=lambda k: values[k] - out[k], reverse=True)
    for key in order[:max(total - sum(out.values()), 0)]:
        out[key] += 1
    return out


def preview(call):
    if not call:
        return ""
    inp = call["input"]
    for key in ("command", "description", "file_path", "pattern", "skill",
                "prompt"):
        if inp.get(key):
            text = str(inp[key])
            if key == "skill" and inp.get("args"):
                text += " " + str(inp["args"])
            break
    else:
        text = json.dumps(inp)
    return " ".join(text.split())[:60]


def phase_rows(messages):
    rows = OrderedDict()
    for msg in messages:
        row = rows.setdefault(msg["phase"], {
            "phase": msg["phase"], "messages": 0, "usd": 0.0,
            "unpriced_messages": 0, "admitted": 0,
            "split": OrderedDict((b, 0.0) for b in BUCKETS)})
        row["messages"] += 1
        if msg["usd"] is None:
            row["unpriced_messages"] += 1
        else:
            row["usd"] += msg["usd"]
        row["admitted"] += msg["admitted"]
        for bucket, value in msg["split"].items():
            row["split"][bucket] += value
    order = {p: i for i, p in enumerate(PHASE_ORDER)}
    out = sorted(rows.values(), key=lambda r: order.get(r["phase"], 99))
    for row in out:
        row["split"] = lr_round(row["split"], row["admitted"])
        if row["unpriced_messages"] == row["messages"]:
            row["usd"] = None
    return out


def work_order_rows(messages, tools, agent_meta, consumed_at):
    index = {m["id"]: i for i, m in enumerate(messages)}
    by_tool = {m.get("toolUseId"): m for m in agent_meta}
    result_chars = {}
    for msg in messages:
        for item in msg["inputs"]:
            # A Workflow's result arrives as its task notification.
            kind = "handback" if item["kind"] == "notification" and \
                item["tool"] == "Workflow" else item["kind"]
            if item["tool"] in DISPATCH_TOOLS and kind in ("handback",
                                                           "tool_result"):
                key = (item["tool_use_id"], kind)
                result_chars[key] = result_chars.get(key, 0) + item["chars"]
    rows = []
    for tid, call in tools.items():
        if call["name"] not in DISPATCH_TOOLS:
            continue
        meta = by_tool.get(tid, {})
        start = index[call["msg"]]
        end = consumed_at.get(tid, len(messages) - 1)
        window = messages[start:end + 1]
        main_usd = sum(m["usd"] for m in window if m["usd"] is not None)
        builder_usd = meta.get("usd")
        workflow = call["name"] == "Workflow"
        rows.append({
            "tool_use_id": tid,
            "agent_type": "workflow" if workflow else
            call["input"].get("subagent_type") or "general-purpose",
            "description": call["input"].get("name" if workflow else
                                             "description") or "",
            "agent_file": meta.get("path"),
            "builder_usd": builder_usd,
            "builder_messages": meta.get("messages"),
            "main_usd": main_usd,
            "main_unpriced": sum(m["usd"] is None for m in window),
            "main_messages": end - start + 1,
            "consumed": tid in consumed_at,
            "ack_chars": result_chars.get((tid, "tool_result"), 0),
            "result_chars": result_chars.get((tid, "handback"),
                                             result_chars.get((tid, "tool_result"), 0)),
            "ratio": main_usd / builder_usd if builder_usd else None})
    return rows


def top_admissions(messages, tools, count):
    items = []
    for msg in messages:
        for item in msg["inputs"]:
            items.append({
                "kind": item["kind"], "tool": item["tool"] or "-",
                "input": preview(tools.get(item.get("tool_use_id"))),
                "phase": msg["phase"], "chars": item["chars"]})
    items.sort(key=lambda i: i["chars"], reverse=True)
    return items[:count]


def load_agent_meta(main_path):
    metas = []
    for path, meta in subagent_files(main_path):
        messages, _ = load_messages(path)
        by_model = summarize(messages)
        entry = dict(meta)
        priced = all(r["priced"] for r in by_model.values())
        entry.update(path=path, messages=len(messages),
                     agentId=entry.get("agentId") or
                     os.path.basename(path)[len("agent-"):-len(".jsonl")],
                     usd=sum(r["usd"] for r in by_model.values())
                     if priced else None)
        metas.append(entry)
    return metas


def phases_data(main_path, top):
    messages, tools = load_timeline(main_path)
    agent_meta = load_agent_meta(main_path)
    link_agents(messages, agent_meta)
    resolve_items(messages, tools, agent_meta)
    consumed_at = deliveries(messages, tools, agent_meta)
    classify(messages, consumed_at)
    attribute(messages)
    by_model = summarize(OrderedDict((m["id"], (m["model"], m["usage"]))
                                     for m in messages))
    return {
        "main": main_path,
        "messages": len(messages),
        "usd": sum(m["usd"] for m in messages if m["usd"] is not None),
        "unpriced": [m for m, r in by_model.items() if not r["priced"]],
        "admitted": sum(m["admitted"] for m in messages),
        "phases": phase_rows(messages),
        "ride_along": sum(1 for m in messages if m.get("ride_along")),
        "work_orders": work_order_rows(messages, tools, agent_meta, consumed_at),
        "top_admissions": top_admissions(messages, tools, top),
        "one_hour": OrderedDict(
            (m, {"cache_write_1h": r["cache_write_1h"], "priced": r["priced"]})
            for m, r in by_model.items() if r["cache_write_1h"]),
        "timeline": [{"id": m["id"], "phase": m["phase"],
                      "boundary": m.get("reason"), "usd": m["usd"],
                      "ride_along": m.get("ride_along", False),
                      "admitted": m["admitted"],
                      "split": lr_round(m["split"], m["admitted"])}
                     for m in messages]}


def print_phases(data):
    short = ("Agent", "Bash", "Read", "Grep/Glob", "Skill", "other", "prev-out",
             "rebuild")
    print("%-15s %5s %9s %9s  " % ("phase", "msgs", "USD", "admitted")
          + " ".join("%9s" % s for s in short))
    for row in data["phases"]:
        print("%-15s %5d %s %9d  " % (row["phase"], row["messages"],
                                      fmt_usd(row["usd"],
                                              row["unpriced_messages"]),
                                      row["admitted"])
              + " ".join("%9d" % v for v in row["split"].values()))
    unpriced = sum(r["unpriced_messages"] for r in data["phases"])
    print("%-15s %5d %s %9d" % ("total", data["messages"],
                                fmt_usd(None if unpriced == data["messages"]
                                        else data["usd"], unpriced),
                                data["admitted"]))
    print()
    print("%-22s %-40s %9s %9s %6s %8s %7s" % (
        "agent type", "description", "agent $", "main $", "main#",
        "result", "ratio"))
    for row in data["work_orders"]:
        ratio = "%7.2f" % row["ratio"] if row["ratio"] is not None else "%7s" % "-"
        print("%-22s %-40s %s %s %6d %8d %s%s" % (
            row["agent_type"][:22], row["description"][:40],
            fmt_usd(row["builder_usd"]),
            fmt_usd(None if row["main_unpriced"] == row["main_messages"]
                    else row["main_usd"], row["main_unpriced"]),
            row["main_messages"], row["result_chars"], ratio,
            "" if row["consumed"] else "  (result never consumed)"))
    print()
    print("%6s  %-12s %-6s %-15s %s" % ("chars", "kind", "tool", "phase", "input"))
    for item in data["top_admissions"]:
        print("%6d  %-12s %-6s %-15s %s" % (item["chars"], item["kind"],
                                           item["tool"], item["phase"],
                                           item["input"]))
    if data["ride_along"]:
        print()
        print("note: %d director call(s) rode along on a turn with more than %d tokens of"
              " thinking; those turns keep their surrounding phase"
              % (data["ride_along"], DIRECTOR_RIDE_ALONG_OUT))
    if data["one_hour"]:
        print()
        print_ttl_notes(data["one_hour"])


def selftest():
    """Check the pure rules on inline cases; exit status 1 on any failure."""
    def msg(*blocks, cached=0, written=0, out=0, inputs=()):
        return {"id": len(blocks), "blocks": list(blocks), "inputs": list(inputs),
                "model": "claude-opus-5", "usage": {
                    "cache_read_input_tokens": cached, "output_tokens": out,
                    "cache_creation_input_tokens": written}}
    bash = lambda c: {"type": "tool_use", "name": "Bash", "input": {"command": c}}
    seq = [msg({"type": "tool_use", "name": "Agent", "id": "b",
                "input": {"subagent_type": "opus-builder"}}),
           msg(bash("director emit --type note")), msg(bash("git commit -F m")),
           msg({"type": "tool_use", "name": "Agent", "input": {
               "subagent_type": "Explore"}}), msg(bash("cat /tmp/k3-review-x1")),
           msg(bash("director emit --type note"), out=5000),
           msg({"type": "tool_use", "name": "Agent", "id": "c",
                "input": {"subagent_type": "opus-builder"}},
               bash("director emit --type note"), out=5000),
           msg(bash("director emit --type note " + "x" * 12000), out=3200)]
    classify(seq, {})
    def signals(name, plan=True, **inp):
        block = {"type": "tool_use", "name": name, "id": "t", "input": inp}
        return message_signals(msg(block), plan)[0]
    agent = lambda kind, plan=True: signals("Agent", plan, subagent_type=kind)
    skill = lambda name, plan=True: signals("Skill", plan, skill=name)
    builder = [(2, "build", "builder dispatch")]
    reviewer = [(4, "lane", "review agent")]
    scouted = [(3, "plan", "scout dispatch")]
    activated = [(3, "plan", "build skill activation")]
    reb = [msg(cached=0, written=1000, out=50),
           msg(cached=200, written=900, inputs=[{"chars": 3, "bucket": "Bash"}])]
    attribute(reb)
    mtok = 1000000
    hour_usage = {"input_tokens": 0, "cache_read_input_tokens": 0,
                  "output_tokens": 0, "cache_creation_input_tokens": mtok,
                  "cache_creation": {"ephemeral_5m_input_tokens": 400000,
                                     "ephemeral_1h_input_tokens": 600000}}
    flat_usage = {"cache_creation_input_tokens": mtok}
    over_usage = {"cache_creation_input_tokens": 100,
                  "cache_creation": {"ephemeral_1h_input_tokens": 500}}
    mixed = summarize({1: ("claude-opus-5", hour_usage),
                       2: ("claude-opus-5", flat_usage)})["claude-opus-5"]
    near = lambda a, b: a is not None and abs(a - b) < 1e-9
    checks = {
        "1h write rate": near(usd("claude-opus-5", hour_usage),
                              0.4 * 6.25 + 0.6 * 10.0),
        "5m fallback": near(usd("claude-opus-5", flat_usage), 6.25),
        "1h in summary": summarize({1: ("claude-opus-5", hour_usage)})
        ["claude-opus-5"]["cache_write_1h"] == 600000,
        "1h clamp": near(usd("claude-opus-5", over_usage), 100 * 10.0 / 1e6),
        "mixed split": near(sum(n * r for _, n, r in priced_lines(
            mixed["tokens"], mixed["cache_write_1h"], RATES["claude-opus-5"])),
            mixed["usd"]),
        "fable-5 row": rate_for("claude-fable-5") == (10.0, 1.00, 12.50, 20.0, 50.0)
        and near(usd("claude-fable-5", {"cache_read_input_tokens": mtok}), 1.0),
        "fable-5-1 row": near(usd("claude-fable-5-1",
                                  {"cache_read_input_tokens": mtok}), 0.25),
        "dated haiku": rate_for("claude-haiku-4-5-20251001") ==
        RATES["claude-haiku-4-5"],
        "dated haiku 1m": rate_for("claude-haiku-4-5-20251001[1m]") ==
        RATES["claude-haiku-4-5"],
        "dated id": rate_for("claude-opus-5-20260401") == RATES["claude-opus-5"],
        "point release": rate_for("claude-opus-5-1") is None,
        "context suffix": rate_for("claude-opus-5[1m]") == RATES["claude-opus-5"],
        "rounding": sum(lr_round({"a": 1.4, "b": 1.3, "c": 0.3}, 3).values()) == 3,
        "skip marker": marker_phase("Skipping Phase 4: low stakes.") is None,
        "marker": marker_phase("Doing a Phase 3 read.") == "builder-review",
        "lane launch": lane_launch("cd r; ~/s/k3-review.sh 'p; q'", {}),
        "report read": not lane_launch("cat /tmp/k3-review-abc", {}),
        "old lane wrapper": lane_launch("~/s/opus-review.sh 'p'", {}),
        "claude lane wrapper": lane_launch("cd r; ~/s/claude-review.sh 'p; q'", {}),
        "kimi lane wrapper": lane_launch("cd r; ~/s/kimi-review.sh 'p; q'", {}),
        "new report read": not lane_launch("cat /tmp/kimi-review-abc", {}) and
        not lane_launch("cat /tmp/claude-review-abc", {}),
        "lane wrapper opens lane": [f[1:] for f in signals(
            "Bash", command="~/s/kimi-review.sh 'p'")] == [("lane", "review wrapper")],
        "build skill": skill("delegate-build") == activated,
        "old build skill": skill("opus-build") == activated,
        "build skill after plan": skill("delegate-build", False) == [],
        "unrelated skill": skill("codex:rescue") == [(4, "lane", "codex:rescue skill")],
        "builder dispatch": agent("delegate-builder") == builder,
        "old builder dispatch": agent("opus-builder") == builder,
        "workflow builder": builds("Workflow", {"script": "agent('delegate-builder')"}),
        "old workflow builder": builds("Workflow", {"script": "agent('opus-builder')"}),
        "workflow other agents": not builds("Workflow", {"script": "agent('Explore')"}),
        "workflow no script": builds("Workflow", {"name": "w"}),
        "claude-reviewer": agent("claude-reviewer") == reviewer,
        "old reviewer": agent("opus-reviewer") == reviewer,
        "codex agent": agent("codex:codex-rescue") == reviewer,
        "scout dispatch": agent("scout") == scouted,
        "explore dispatch": agent("Explore") == scouted,
        "scout after plan": agent("scout", False) == [],
        "one-shot": [m["phase"] for m in seq] ==
        ["build", "director", "commit", "build", "build", "build", "build",
         "director"],
        "ride-along": [m.get("ride_along", False) for m in seq] ==
        [False] * 5 + [True, False, False],
        "rebuild": reb[1]["split"]["cache-rebuild"] == 800 and
        reb[1]["split"]["assistant-output"] == 50,
    }
    failed = [name for name, ok in checks.items() if not ok]
    print("selftest: %d/%d ok%s" % (len(checks) - len(failed), len(checks),
                                    "; failed: " + ", ".join(failed) if failed else ""))
    sys.exit(1 if failed else 0)


def main():
    if sys.argv[1:] == ["--selftest"]:
        selftest()
    ap = argparse.ArgumentParser(
        prog=PROG,
        description="Cost and phase breakdown of one Claude Code session.")
    sub = ap.add_subparsers(dest="mode", required=True)
    cost = sub.add_parser("cost", help="list-price cost, main + subagents")
    cost.add_argument("--no-dedup", action="store_true",
                      help="sum every assistant record instead of collapsing "
                           "records that share a message id (diagnostic)")
    cost.add_argument("--include-siblings", action="store_true",
                      help="also count the other sessions in the same "
                           "project dir, and their subagents")
    phases = sub.add_parser("phases", help="where the main loop's tokens went")
    phases.add_argument("--top", type=int, default=10, metavar="N",
                        help="how many of the largest admissions to list")
    for parser in (cost, phases):
        parser.add_argument("--json", action="store_true",
                            help="emit the same data as JSON")
        parser.add_argument("main", metavar="main.jsonl")
    args = ap.parse_args()
    if not os.path.isfile(args.main):
        sys.exit("%s: not a file: %s" % (PROG, args.main))

    if args.mode == "cost":
        data = cost_data(args.main, not args.no_dedup, args.include_siblings)
        show = print_cost
    else:
        data = phases_data(args.main, args.top)
        show = print_phases
    if args.json:
        json.dump(data, sys.stdout, indent=2)
        print()
    else:
        show(data)


if __name__ == "__main__":
    main()
